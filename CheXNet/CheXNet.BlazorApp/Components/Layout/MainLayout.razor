@inherits LayoutComponentBase

<div class="page overflow-hidden">
    <div class="sidebar border-end shadow-sm">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex align-items-center justify-content-between bg-white border-bottom shadow-sm">
            <div class="d-flex align-items-center">
                 <button class="btn btn-sm btn-light d-md-none me-2">
                    <i class="bi bi-list"></i>
                </button>
                <div class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-20 px-3 py-2 rounded-pill outfit fw-bold">
                    <i class="bi bi-shield-check-fill me-2"></i>Secure Diagnostic Session
                </div>
            </div>
            <div class="user-profile d-flex align-items-center">
                <div class="text-end me-3 d-none d-sm-block">
                    <div class="small fw-bold outfit">Dr. Gazy Expert</div>
                    <div class="text-muted" style="font-size: 0.75rem;">Senior Radiologist</div>
                </div>
                <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center text-white shadow-sm" style="width: 40px; height: 40px;">
                    <i class="bi bi-person-fill fs-5"></i>
                </div>
            </div>
        </div>

        <article class="content">
            @Body
        </article>
    </main>
</div>

<style>
    :root {
        --sidebar-width: 280px;
    }

    .sidebar { 
        width: var(--sidebar-width) !important; 
        background: #ffffff !important;
        z-index: 100;
    }

    main { 
        flex: 1;
        display: flex;
        flex-direction: column;
        height: 100vh;
        overflow-y: auto;
        background-color: var(--light);
    }

    .top-row { height: 70px; flex-shrink: 0; position: sticky; top: 0; z-index: 99; }

    .content { flex: 1; }
</style>
