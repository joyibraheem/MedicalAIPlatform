# Build output
**/bin/
**/obj/
**/_build_verify/
**/out/
**/publish/

# IDE / tooling
**/.vs/
**/.vscode/
**/.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser

# Logs and caches
**/[Ll]og/
**/[Ll]ogs/
*.cache
*.tmp
*.temp

# NuGet
**/*.nupkg
**/*.snupkg
**/packages/
project.lock.json
project.fragment.lock.json
artifacts/

# Git
.git/
.gitignore
.gitattributes

# Local secrets (never send to build context)
.env
.env.local
.env.*.local

# Docker docs are not needed inside the image
DOCKER_README.md
DOCKER_SETUP_SUMMARY.md
QUICK_START.md

# OS junk
.DS_Store
Thumbs.db

# Test output
**/[Tt]est[Rr]esult*/
**/[Bb]uild[Ll]og.*
