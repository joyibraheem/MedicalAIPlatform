<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- IIS / IIS Express: default maxAllowedContentLength is ~30 MB, which rejects combined multimodal uploads before Kestrel. -->
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <!-- 536870912 = 512 MiB — keep in sync with Program.cs maxUploadBytes and AnalyticsController limits -->
          <requestLimits maxAllowedContentLength="536870912" />
        </requestFiltering>
      </security>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
