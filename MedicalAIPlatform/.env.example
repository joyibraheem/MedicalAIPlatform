# Copy this file to .env before running Docker Compose:
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env        (Windows)
#
# .env is gitignored. Never commit real secrets.

# SQL Server SA password (must meet SQL Server complexity rules)
MSSQL_SA_PASSWORD=ChangeMe_SaPassword123!

# Demo accounts created when DOCKER_DEMO_SEED=true (local Docker only)
MEDICALAI_DEV_ADMIN_PASSWORD=ChangeMe_Admin123!
MEDICALAI_DEV_DOCTOR_PASSWORD=ChangeMe_Doctor123!

# Set to false to skip demo admin/doctor account creation
DOCKER_DEMO_SEED=true
