@{
    ViewData["Title"] = "Select Patient";
    Layout = "_DoctorLayout";
}

<link rel="stylesheet" href="~/css/analytics.css" asp-append-version="true" />

<div class="analytics-container">
    <div class="analytics-overlay">
        <!-- Header -->
        <div class="patient-header">
            <button class="back-button" onclick="window.location.href='@Url.Action("Index", "Dashboard")'">
                <i class="bi bi-arrow-left"></i>
            </button>
            <div class="patient-info">
                <div class="patient-name">Select Patient</div>
            </div>
        </div>

        <!-- Title -->
        <div class="command-center-title">
            <h1>Select Patient</h1>
            <p>Choose a patient to view their records and generate results</p>
        </div>

        <!-- Search Card -->
        <div class="case-input-card mb-4">
            <div class="input-section">
                <label class="input-label">Search Patient</label>
                <input type="text" id="patientSearchInput" class="form-control" placeholder="Search by name, patient ID, or email..." autocomplete="off" />
            </div>
        </div>

        <!-- Patient List -->
        <div class="case-input-card">
            <div id="patientListContainer">
                <div class="text-center py-5">
                    <i class="bi bi-search" style="font-size: 3rem; color: #6c757d;"></i>
                    <p class="mt-3">Start typing to search for patients...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const searchInput = document.getElementById('patientSearchInput');
            const container = document.getElementById('patientListContainer');
            const searchUrl = '@Url.Action("SearchPatients", "Patient")';
            const detailsBase = '@Url.Action("Details", "Patient")';

            function esc(s) {
                var d = document.createElement('div');
                d.textContent = s == null ? '' : String(s);
                return d.innerHTML;
            }

            function showPlaceholder() {
                container.innerHTML =
                    '<div class="text-center py-5">' +
                    '<i class="bi bi-search" style="font-size: 3rem; color: #6c757d;"></i>' +
                    '<p class="mt-3">Start typing to search for patients...</p>' +
                    '</div>';
            }

            function showEmpty(term) {
                container.innerHTML =
                    '<div class="text-center py-5">' +
                    '<i class="bi bi-inbox" style="font-size: 3rem; color: #6c757d;"></i>' +
                    '<p class="mt-3">No patients found matching "' +
                    esc(term) +
                    '"</p>' +
                    '</div>';
            }

            function renderTable(patients) {
                var html =
                    '<div class="table-responsive"><table class="table table-hover">' +
                    '<thead><tr><th>Profile</th><th>Name</th><th>Patient ID</th><th>Date of Birth</th><th>Actions</th></tr></thead><tbody>';
                patients.forEach(function (p) {
                    html +=
                        '<tr>' +
                        '<td><div style="width:50px;height:50px;border-radius:50%;background:#6c757d;display:flex;align-items:center;justify-content:center;color:white;font-weight:bold;">' +
                        esc(p.initials) +
                        '</div></td>' +
                        '<td><strong>' +
                        esc(p.fullName) +
                        '</strong></td>' +
                        '<td>' +
                        esc(p.patientId || 'N/A') +
                        '</td>' +
                        '<td>' +
                        esc(p.dateOfBirth) +
                        '</td>' +
                        '<td><a href="' +
                        detailsBase +
                        '/' +
                        encodeURIComponent(p.id) +
                        '" class="btn btn-sm btn-primary"><i class="bi bi-eye"></i> View</a></td>' +
                        '</tr>';
                });
                html += '</tbody></table></div>';
                container.innerHTML = html;
            }

            let debounceTimer;
            searchInput.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                var term = this.value.trim();
                if (term.length < 2) {
                    showPlaceholder();
                    return;
                }
                debounceTimer = setTimeout(function () {
                    fetch(searchUrl + '?q=' + encodeURIComponent(term), {
                        credentials: 'same-origin',
                        headers: { Accept: 'application/json' }
                    })
                        .then(function (r) {
                            if (!r.ok) throw new Error('HTTP ' + r.status);
                            return r.json();
                        })
                        .then(function (patients) {
                            if (!patients || patients.length === 0) {
                                showEmpty(term);
                                return;
                            }
                            renderTable(patients);
                        })
                        .catch(function (err) {
                            console.error(err);
                            container.innerHTML =
                                '<div class="text-center py-5 text-danger"><p>Could not load patients. Try again.</p></div>';
                        });
                }, 350);
            });

            searchInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    var term = this.value.trim();
                    if (term.length >= 2) searchInput.dispatchEvent(new Event('input'));
                }
            });
        })();
    </script>
}
