@model List<MedicalAIPlatform.Models.PatientViewModel>
@{
    ViewData["Title"] = "Patients";
    Layout = "_DoctorLayout";
}

<link rel="stylesheet" href="~/css/analytics.css" asp-append-version="true" />

<div class="analytics-container">
    <div class="analytics-overlay">
        <!-- Header -->
        <div class="patient-header">
            <button class="back-button" onclick="window.location.href='@Url.Action("Index", "Dashboard")'">
                <i class="bi bi-arrow-left"></i>
            </button>
            <div class="patient-info">
                <div class="patient-name">Patient Management</div>
            </div>
        </div>

        <!-- Title -->
        <div class="command-center-title">
            <h1>Patient Records</h1>
            <p>Manage patient information, history, and medical scans</p>
        </div>

        <!-- Search and Add Button -->
        <div class="case-input-card mb-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="input-section">
                        <input type="text" id="searchInput" class="form-control" placeholder="Search by name, patient ID, or email..." value="@ViewBag.SearchTerm" />
                    </div>
                </div>
                <div class="col-md-4 text-end">
                    <a href="@Url.Action("Create")" class="combined-btn">
                        <i class="bi bi-plus-circle"></i> Add New Patient
                    </a>
                </div>
            </div>
        </div>

        <!-- Patient List -->
        <div class="case-input-card">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Profile</th>
                                <th>Name</th>
                                <th>Patient ID</th>
                                <th>Date of Birth</th>
                                <th>Gender</th>
                                <th>Contact</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var patient in Model)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(patient.ProfileImageDataUrl))
                                        {
                                            <img src="@patient.ProfileImageDataUrl" alt="Profile" style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div style="width: 50px; height: 50px; border-radius: 50%; background: #6c757d; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold;">
                                                @patient.FirstName[0]@patient.LastName[0]
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <strong>@patient.FullName</strong>
                                    </td>
                                    <td>@(patient.PatientId ?? "N/A")</td>
                                    <td>@patient.DateOfBirth.ToString("yyyy-MM-dd")</td>
                                    <td>@patient.Gender</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(patient.Email))
                                        {
                                            <div>@patient.Email</div>
                                        }
                                        @if (!string.IsNullOrEmpty(patient.PhoneNumber))
                                        {
                                            <div>@patient.PhoneNumber</div>
                                        }
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Details", new { id = patient.Id })" class="btn btn-sm btn-primary">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox" style="font-size: 3rem; color: #6c757d;"></i>
                    <p class="mt-3">No patients found. <a href="@Url.Action("Create")">Add your first patient</a></p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById('searchInput');
        let searchTimeout;

        searchInput.addEventListener('input', function() {
            clearTimeout(searchTimeout);
            const searchTerm = this.value.trim();
            
            searchTimeout = setTimeout(() => {
                if (searchTerm.length > 0 || searchTerm.length === 0) {
                    window.location.href = '@Url.Action("Index")?searchTerm=' + encodeURIComponent(searchTerm);
                }
            }, 500);
        });

        // Handle Enter key
        searchInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                const searchTerm = this.value.trim();
                window.location.href = '@Url.Action("Index")?searchTerm=' + encodeURIComponent(searchTerm);
            }
        });
    </script>
}
