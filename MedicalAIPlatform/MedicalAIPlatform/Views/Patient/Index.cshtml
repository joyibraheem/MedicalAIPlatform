@model List<MedicalAIPlatform.Models.PatientViewModel>
@{
    ViewData["Title"] = "Patients";
    Layout = "_DoctorLayout";
}

<link rel="stylesheet" href="~/css/analytics.css" asp-append-version="true" />

<div class="analytics-container">
    <div class="analytics-overlay">
        <!-- Header -->
        <div class="patient-header">
            <button class="back-button" onclick="window.location.href='@Url.Action("Index", "Dashboard")'">
                <i class="bi bi-arrow-left"></i>
            </button>
            <div class="patient-info">
                <div class="patient-name">Patient Management</div>
            </div>
        </div>

        <!-- Title -->
        <div class="command-center-title">
            <h1>Patient Records</h1>
            <p>Manage patient information, history, and medical scans</p>
        </div>

        <!-- Search and Add Button -->
        <div class="case-input-card mb-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="input-section">
                        <input type="text" id="searchInput" class="form-control" placeholder="Search by name, patient ID, or email..." autocomplete="off" />
                    </div>
                </div>
                <div class="col-md-4 text-end">
                    <a href="@Url.Action("Create")" class="combined-btn">
                        <i class="bi bi-plus-circle"></i> Add New Patient
                    </a>
                </div>
            </div>
        </div>

        <!-- Patient List -->
        <div class="case-input-card">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Profile</th>
                                <th>Name</th>
                                <th>Patient ID</th>
                                <th>Date of Birth</th>
                                <th>Gender</th>
                                <th>Contact</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="patientTableBody">
                            @foreach (var patient in Model)
                            {
                                var searchBlob = string.Join(' ',
                                    patient.FirstName,
                                    patient.LastName,
                                    patient.FullName,
                                    patient.PatientId ?? "",
                                    patient.Email ?? "",
                                    patient.PhoneNumber ?? "",
                                    patient.DateOfBirth.ToString("yyyy-MM-dd"),
                                    patient.Gender).ToLowerInvariant();
                                <tr class="patient-row" data-search="@searchBlob">
                                    <td>
                                        @if (!string.IsNullOrEmpty(patient.ProfileImageDataUrl))
                                        {
                                            <img src="@patient.ProfileImageDataUrl" alt="Profile" style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div style="width: 50px; height: 50px; border-radius: 50%; background: #6c757d; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold;">
                                                @patient.FirstName[0]@patient.LastName[0]
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <strong>@patient.FullName</strong>
                                    </td>
                                    <td>@(patient.PatientId ?? "N/A")</td>
                                    <td>@patient.DateOfBirth.ToString("yyyy-MM-dd")</td>
                                    <td>@patient.Gender</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(patient.Email))
                                        {
                                            <div>@patient.Email</div>
                                        }
                                        @if (!string.IsNullOrEmpty(patient.PhoneNumber))
                                        {
                                            <div>@patient.PhoneNumber</div>
                                        }
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Details", new { id = patient.Id })" class="btn btn-sm btn-primary">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p id="patientSearchNoResults" class="text-center text-muted py-4 mb-0" style="display:none;" role="status">
                        No patients match your search.
                    </p>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox" style="font-size: 3rem; color: #6c757d;"></i>
                    <p class="mt-3">No patients found. <a href="@Url.Action("Create")">Add your first patient</a></p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const searchInput = document.getElementById('searchInput');
            const tbody = document.getElementById('patientTableBody');
            const noResults = document.getElementById('patientSearchNoResults');
            if (!searchInput || !tbody) return;

            function normalizeQuery(s) {
                return (s || '').trim().toLowerCase();
            }

            /** Match if every whitespace-separated token appears somewhere in the row haystack (order-independent). */
            function rowMatches(haystack, q) {
                if (!q) return true;
                const tokens = q.split(/\s+/).filter(Boolean);
                return tokens.every(function (t) {
                    return haystack.indexOf(t) !== -1;
                });
            }

            function applyFilter() {
                const q = normalizeQuery(searchInput.value);
                const rows = tbody.querySelectorAll('tr.patient-row');
                let visible = 0;
                rows.forEach(function (tr) {
                    var hay = tr.getAttribute('data-search') || '';
                    var ok = rowMatches(hay, q);
                    tr.style.display = ok ? '' : 'none';
                    if (ok) visible++;
                });
                if (noResults) {
                    noResults.style.display = q.length > 0 && visible === 0 ? 'block' : 'none';
                }
            }

            var debounceTimer;
            searchInput.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(applyFilter, 200);
            });

            searchInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    applyFilter();
                }
            });

            // One-time: old bookmarks like /Patient?searchTerm=emily — pre-fill box and drop query from address bar
            try {
                var params = new URLSearchParams(window.location.search);
                var legacy = params.get('searchTerm');
                if (legacy !== null && legacy !== '') {
                    searchInput.value = legacy;
                    window.history.replaceState(null, '', window.location.pathname);
                }
            } catch (_) { /* ignore */ }

            applyFilter();
        })();
    </script>
}
