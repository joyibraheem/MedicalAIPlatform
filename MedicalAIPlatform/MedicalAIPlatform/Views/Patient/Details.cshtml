                            lungAICheckbox.checked = true;
                            lungAICheckbox.disabled = false;
                        }
                        updateModelSelection();
                    }
                }, { once: true });
                
            } catch (error) {
                console.error('Error opening link models modal:', error);
                alert('An error occurred while opening the modal. Please check the browser console for details.');
            }
        }

        // Make linkModels function globally accessible
        window.linkModels = function() {
             const uploadModalElement = document.getElementsByClassName('modal-backdrop');
            uploadModalElement?.classList?.remove('show', 'fade','modal-backdrop');
            console.log('=== linkModels function called ===');
            const patientId = document.getElementById('linkPatientId')?.value;
            const scanId = document.getElementById('linkScanId')?.value;
            const clinicalText = document.getElementById('linkClinicalText')?.value || '';
            
            if (!patientId || !scanId) {
                alert('Error: Missing patient or scan information. Please close the modal and try again.');
                console.error('Missing parameters:', { patientId, scanId });
                return;
            }
            
            const chexnetCheckbox = document.getElementById('modelCheXNet');
            const biobertCheckbox = document.getElementById('modelBioBert');
            const lungAICheckbox = document.getElementById('modelLungAI');
            
            if (!chexnetCheckbox || !biobertCheckbox || !lungAICheckbox) {
                alert('Error: Form elements not found. Please refresh the page.');
                console.error('Checkboxes not found');
                return;
            }
            
            // Get scan type from modal data attribute as fallback
            const modalElement = document.getElementById('linkModelsModal');
            const scanType = modalElement ? modalElement.getAttribute('data-scan-type') || '' : '';
            const lowerScanType = scanType.toLowerCase();
            
            console.log('=== Link Models Function Called ===');
            console.log('Patient ID:', patientId, 'Scan ID:', scanId);
            console.log('Scan Type:', scanType);
            console.log('Checkbox states:');
            console.log('  CheXNet - checked:', chexnetCheckbox.checked, 'disabled:', chexnetCheckbox.disabled);
            console.log('  BioBert - checked:', biobertCheckbox.checked, 'disabled:', biobertCheckbox.disabled);
            console.log('  LungAI - checked:', lungAICheckbox.checked, 'disabled:', lungAICheckbox.disabled);
            
            const models = [];
            
            // Collect checked and enabled models
            if (chexnetCheckbox.checked && !chexnetCheckbox.disabled) {
                models.push('CheXNet');
            }
            if (biobertCheckbox.checked && !biobertCheckbox.disabled) {
                models.push('BioBert');
            }
            if (lungAICheckbox.checked && !lungAICheckbox.disabled) {
                models.push('LungAI');
            }

            console.log('Models collected:', models);

            // If no models selected, force select based on scan type
            if (models.length === 0) {
                console.warn('No models selected! Auto-selecting based on scan type...');
                
                if (scanType === 'XRay' || lowerScanType === 'xray' || lowerScanType === 'x-ray') {
                    chexnetCheckbox.checked = true;
                    chexnetCheckbox.disabled = false;
                    models.push('CheXNet');
                    console.log('✓ Auto-selected CheXNet for X-Ray');
                } else if (scanType === 'CTScan' || lowerScanType === 'ctscan' || lowerScanType === 'ct scan' || lowerScanType === 'ct') {
                    lungAICheckbox.checked = true;
                    lungAICheckbox.disabled = false;
                    models.push('LungAI');
                    console.log('✓ Auto-selected LungAI for CT Scan');
                } else {
                    // Last resort: select first enabled checkbox
                    if (!chexnetCheckbox.disabled) {
                        chexnetCheckbox.checked = true;
                        models.push('CheXNet');
                        console.log('✓ Emergency: Selected CheXNet');
                    } else if (!lungAICheckbox.disabled) {
                        lungAICheckbox.checked = true;
                        models.push('LungAI');
                        console.log('✓ Emergency: Selected LungAI');
                    }
                }
                
                if (models.length === 0) {
                    alert('Error: Could not determine which model to use. Please manually select at least one model.');
                    return;
                }
            }
            
            console.log('Final models to link:', models);
            
            // Validate BioBert requires clinical text
            if (models.includes('BioBert') && !clinicalText.trim()) {
                const useBioBert = confirm('BioBert requires clinical text. You haven\'t entered any text. Do you want to continue without BioBert?');
                if (useBioBert) {
                    models.splice(models.indexOf('BioBert'), 1);
                } else {
                    return; // User cancelled, they want to add text
                }
            }

            const formData = new FormData();
            formData.append('patientId', patientId);
            formData.append('scanId', scanId);
            formData.append('models', JSON.stringify(models));
            if (clinicalText) {
                formData.append('clinicalText', clinicalText);
            }

            // Add anti-forgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
                formData.append('__RequestVerificationToken', token.value);
            }

            // Show loading state
            const linkBtn = document.getElementById('linkModelsBtn');
            const originalBtnText = linkBtn ? linkBtn.innerHTML : '';
            if (linkBtn) {
                linkBtn.disabled = true;
                linkBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Linking Models...';
            }

            fetch('@Url.Action("LinkModels")', {
                method: 'POST',
                body: formData
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    // Show success message
                    if (linkBtn) {
                        linkBtn.innerHTML = '<i class="bi bi-check-circle"></i> Success!';
                        linkBtn.classList.remove('btn-primary');
                        linkBtn.classList.add('btn-success');
                    }
                    
                    // Close modal after a short delay
                    setTimeout(() => {
                        const modalElement = document.getElementById('linkModelsModal');
                        if (modalElement) {
                            const modal = bootstrap.Modal.getInstance(modalElement);
                            if (modal) modal.hide();
                        }
                        location.reload();
                    }, 1500);
                } else {
                    // Restore button
                    if (linkBtn) {
                        linkBtn.disabled = false;
                        linkBtn.innerHTML = originalBtnText;
                    }
                    alert('Error: ' + (data.error || 'Unknown error occurred'));
                }
            })
            .catch(error => {
                // Restore button
                if (linkBtn) {
                    linkBtn.disabled = false;
                    linkBtn.innerHTML = originalBtnText;
                }
                console.error('Error linking models:', error);
                alert('Error linking models: ' + error.message + '. Please check your connection and try again.');
            });
        };
        
