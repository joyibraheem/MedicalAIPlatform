                if (!chexnetCheckbox || !lungAICheckbox || !biobertCheckbox) {
                    alert('Error: Form elements not found. Please refresh the page.');
                    console.error('Checkboxes not found');
                    return;
                }
                
                // Reset all checkboxes first
                chexnetCheckbox.checked = false;
                biobertCheckbox.checked = false;
                lungAICheckbox.checked = false;
                chexnetCheckbox.disabled = false;
                lungAICheckbox.disabled = false;
                biobertCheckbox.disabled = false;
                
                // Normalize scan type
                const normalizedScanType = (scanType || '').trim();
                const lowerScanType = normalizedScanType.toLowerCase();
                
                console.log('Normalized scan type:', normalizedScanType);
                console.log('Lower scan type:', lowerScanType);
                
                // Set up models based on scan type
                if (normalizedScanType === 'XRay' || lowerScanType === 'xray' || lowerScanType === 'x-ray') {
                    chexnetCheckbox.disabled = false;
                    chexnetCheckbox.checked = true;
                    lungAICheckbox.disabled = true;
                    lungAICheckbox.checked = false;
                    console.log('✓ X-Ray detected - CheXNet auto-selected');
                } else if (normalizedScanType === 'CTScan' || lowerScanType === 'ctscan' || lowerScanType === 'ct scan' || lowerScanType === 'ct') {
                    chexnetCheckbox.disabled = true;
                    chexnetCheckbox.checked = false;
                    lungAICheckbox.disabled = false;
                    lungAICheckbox.checked = true;
                    console.log('✓ CT Scan detected - LungAI auto-selected');
                } else {
                    console.warn('Unknown scan type:', normalizedScanType, '- enabling all models');
                }
                
                // BioBert is always available
                biobertCheckbox.disabled = false;
                
                // Clear clinical text
                const clinicalTextArea = document.getElementById('linkClinicalText');
                if (clinicalTextArea) clinicalTextArea.value = '';
                
                // Show modal using Bootstrap
                if (typeof bootstrap === 'undefined' || !bootstrap.Modal) {
                    alert('Error: Bootstrap is not loaded. Please refresh the page.');
                    console.error('Bootstrap Modal not available');
                    return;
                }
                
                // Final cleanup - remove any lingering backdrops before creating new modal
                const lingeringBackdrops = document.querySelectorAll('.modal-backdrop');
                if (lingeringBackdrops.length > 0) {
                    console.log('Removing lingering backdrops before showing modal:', lingeringBackdrops.length);
                    lingeringBackdrops.forEach(backdrop => backdrop.remove());
                }
                
                // Ensure body is clean
                document.body.classList.remove('modal-open');
                document.body.style.overflow = '';
                document.body.style.paddingRight = '';
                
                // Dispose any existing modal instance to avoid conflicts
                const existingModal = bootstrap.Modal.getInstance(modalElement);
                if (existingModal) {
                    existingModal.dispose();
                }
                
                // Ensure modal has proper z-index BEFORE showing
                modalElement.style.zIndex = '1055';
                const modalDialog = modalElement.querySelector('.modal-dialog');
                if (modalDialog) {
                    modalDialog.style.zIndex = '1056';
                    modalDialog.style.position = 'relative';
                }
                const modalContent = modalElement.querySelector('.modal-content');
                if (modalContent) {
                    modalContent.style.zIndex = '1057';
                    modalContent.style.position = 'relative';
                }
                
                // Create new modal instance WITHOUT backdrop to avoid blocking issues
                const modal = new bootstrap.Modal(modalElement, {
                    backdrop: false,  // Disable backdrop to prevent blocking
                    keyboard: true,   // Allow ESC to close
                    focus: true       // Auto-focus on modal
                });
                
                // Set up buttons BEFORE showing modal
                setupModalButtons();
                
                // Show modal
                modal.show();
                
                // Remove any backdrop that Bootstrap might have created anyway
                setTimeout(() => {
                    const backdrops = document.querySelectorAll('.modal-backdrop');
                    backdrops.forEach(backdrop => {
                        console.log('Removing backdrop that Bootstrap created');
                        backdrop.remove();
                    });
                    // Clean up body classes
                    document.body.classList.remove('modal-open');
                    document.body.style.overflow = '';
                    document.body.style.paddingRight = '';
                }, 10);
                
                // Aggressive backdrop removal - remove ALL backdrops immediately
                const removeAllBackdrops = function() {
                    const backdrops = document.querySelectorAll('.modal-backdrop');
                    if (backdrops.length > 0) {
                        console.log(`Removing ${backdrops.length} backdrop(s)`);
                        backdrops.forEach(backdrop => {
                            backdrop.remove();
                        });
                    }
                    // Clean up body classes
                    document.body.classList.remove('modal-open');
                    document.body.style.overflow = '';
                    document.body.style.paddingRight = '';
                    document.body.style.removeProperty('overflow');
                    document.body.style.removeProperty('padding-right');
                };
                
                // Remove backdrops immediately and repeatedly
                removeAllBackdrops();
                setTimeout(removeAllBackdrops, 10);
                setTimeout(removeAllBackdrops, 50);
                setTimeout(removeAllBackdrops, 100);
                setTimeout(removeAllBackdrops, 200);
                
                // Check when modal is fully shown
                modalElement.addEventListener('shown.bs.modal', function() {
                    removeAllBackdrops();
                    
                    // Ensure modal is visible and interactive
                    modalElement.style.zIndex = '1055';
                    modalElement.style.pointerEvents = 'auto';
                    modalElement.style.display = 'block';
                    if (modalDialog) {
                        modalDialog.style.zIndex = '1056';
                        modalDialog.style.pointerEvents = 'auto';
                    }
                    if (modalContent) {
                        modalContent.style.zIndex = '1057';
                        modalContent.style.pointerEvents = 'auto';
                    }
                    
                    // Force all interactive elements to be clickable
                    const allButtons = modalElement.querySelectorAll('button, input, textarea, select, a, .form-check-input, .form-check-label');
                    allButtons.forEach(btn => {
                        btn.style.pointerEvents = 'auto';
                        btn.style.cursor = 'pointer';
                    });
                    
                    // Final backdrop removal
                    removeAllBackdrops();
                    
                    updateModelSelection();
