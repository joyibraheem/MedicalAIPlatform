        function updateModelSelection() {
             const uploadModalElement = document.getElementsByClassName('modal-backdrop');
            uploadModalElement?.classList?.remove('show', 'fade','modal-backdrop');
            // Update visual indicators
            const chexnet = document.getElementById('modelCheXNet');
            const biobert = document.getElementById('modelBioBert');
            const lungai = document.getElementById('modelLungAI');
            
            const chexnetBadge = document.getElementById('chexnetBadge');
            const biobertBadge = document.getElementById('biobertBadge');
            const lungaiBadge = document.getElementById('lungaiBadge');
            const chexnetCard = document.getElementById('chexnetCard');
            const biobertCard = document.getElementById('biobertCard');
            const lungaiCard = document.getElementById('lungaiCard');
            
            // Update badges
            if (chexnetBadge) chexnetBadge.style.display = chexnet.checked ? 'inline' : 'none';
            if (biobertBadge) biobertBadge.style.display = biobert.checked ? 'inline' : 'none';
            if (lungaiBadge) lungaiBadge.style.display = lungai.checked ? 'inline' : 'none';
            
            // Update card borders to highlight selected
            if (chexnetCard) {
                chexnetCard.style.borderColor = chexnet.checked ? '#0d6efd' : '#e0e0e0';
                chexnetCard.style.backgroundColor = chexnet.checked ? '#f0f7ff' : '#fff';
            }
            if (biobertCard) {
                biobertCard.style.borderColor = biobert.checked ? '#0d6efd' : '#e0e0e0';
                biobertCard.style.backgroundColor = biobert.checked ? '#f0f7ff' : '#fff';
            }
            if (lungaiCard) {
                lungaiCard.style.borderColor = lungai.checked ? '#0d6efd' : '#e0e0e0';
                lungaiCard.style.backgroundColor = lungai.checked ? '#f0f7ff' : '#fff';
            }
            
            // Update info text
            const selected = [];
            if (chexnet && chexnet.checked) selected.push('CheXNet');
            if (biobert && biobert.checked) selected.push('BioBert');
            if (lungai && lungai.checked) selected.push('LungAI');
            
            const infoTextEl = document.getElementById('modelInfoText');
            if (infoTextEl) {
                if (selected.length > 0) {
                    infoTextEl.innerHTML = `<strong>✓ ${selected.length} model(s) selected:</strong> ${selected.join(', ')}. Click <strong>"Link Models"</strong> button below to proceed.`;
                } else {
                    infoTextEl.textContent = '⚠️ Please select at least one AI model. The appropriate model for your scan type should be pre-selected.';
                }
            }
            
            // Update button state
            const linkBtn = document.getElementById('linkModelsBtn');
            const linkBtnText = document.getElementById('linkBtnText');
            if (linkBtn) {
                if (selected.length > 0) {
                    linkBtn.disabled = false;
                    linkBtn.classList.remove('btn-secondary');
                    linkBtn.classList.add('btn-primary');
                    if (linkBtnText) {
                        linkBtnText.textContent = 'Link Models (' + selected.length + ')';
                    } else {
                        linkBtn.innerHTML = '<i class="bi bi-link-45deg"></i> Link Models (' + selected.length + ')';
                    }
                } else {
                    linkBtn.disabled = true;
                    linkBtn.classList.remove('btn-primary');
                    linkBtn.classList.add('btn-secondary');
                    if (linkBtnText) {
                        linkBtnText.textContent = 'Select a Model First';
                    } else {
                        linkBtn.innerHTML = '<i class="bi bi-exclamation-triangle"></i> Select a Model First';
                    }
                }
            }
        }

