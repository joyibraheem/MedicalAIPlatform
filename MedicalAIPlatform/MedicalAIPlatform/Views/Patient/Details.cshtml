        function uploadScan() {
             const uploadModalElement = document.getElementsByClassName('modal-backdrop');
            uploadModalElement?.classList?.remove('show', 'fade','modal-backdrop');
            const patientId = document.getElementById('uploadPatientId').value;
            const scanType = document.getElementById('uploadScanType').value;
            const scanFile = document.getElementById('uploadScanFile').files[0];
            const conditionText = document.getElementById('uploadConditionText').value;

            if (!scanType || !scanFile) {
                alert('Please select scan type and file.');
                return;
            }

            const formData = new FormData();
            formData.append('patientId', patientId);
            formData.append('scanFile', scanFile);
            formData.append('scanType', scanType);
            if (conditionText) {
                formData.append('conditionText', conditionText);
            }

            // Add anti-forgery token to form data
            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
                formData.append('__RequestVerificationToken', token.value);
            }

            fetch('@Url.Action("UploadScan")', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error: ' + data.error);
                }
            })
            .catch(error => {
                alert('Error uploading scan: ' + error);
            });
        }

        function openLinkModelsModal(patientId, scanId, scanType) {
            try {
