                    // Verify selection
                    const selected = [];
                    if (chexnetCheckbox.checked && !chexnetCheckbox.disabled) selected.push('CheXNet');
                    if (biobertCheckbox.checked && !biobertCheckbox.disabled) selected.push('BioBert');
                    if (lungAICheckbox.checked && !lungAICheckbox.disabled) selected.push('LungAI');
                    
                    console.log('Models selected after modal shown:', selected);
                    
                    // If nothing is selected, force select the appropriate one
                    if (selected.length === 0) {
