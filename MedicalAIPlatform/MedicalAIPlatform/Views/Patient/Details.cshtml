@model MedicalAIPlatform.Models.PatientDetailsViewModel
@{
    ViewData["Title"] = $"Patient: {Model.Patient.FullName}";
    Layout = "_DoctorLayout";
}
@Html.AntiForgeryToken()

<link rel="stylesheet" href="~/css/analytics.css" asp-append-version="true" />
<style>
    /* Modal styling - ensure it's visible and clickable */
    #linkModelsModal .modal-content {
        border: none;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }
    
    #linkModelsModal .modal-header {
        border-bottom: 2px solid rgba(255, 255, 255, 0.1);
    }
    
    #linkModelsModal .modal-footer {
        border-top: 1px solid #dee2e6;
        padding: 1rem 1.5rem;
    }
    
    /* Ensure buttons are clickable */
    #linkModelsBtn, #cancelLinkBtn {
        transition: all 0.2s ease;
    }
    
    #linkModelsBtn:hover:not(:disabled) {
        transform: translateY(-1px);
        box-shadow: 0 4px 8px rgba(0, 123, 255, 0.3);
    }
    
    #cancelLinkBtn:hover {
        transform: translateY(-1px);
    }
    
    /* Modal backdrop - ensure proper z-index */
    .modal-backdrop {
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 1050 !important;
    }
    
    /* Ensure modal is above backdrop */
    .modal {
        z-index: 1055 !important;
    }
    
    #linkModelsModal {
        z-index: 1055 !important;
    }
    
    #linkModelsModal .modal-dialog {
        z-index: 1056 !important;
        position: relative;
    }
    
    #linkModelsModal .modal-content {
        z-index: 1057 !important;
        position: relative;
    }
    
    /* Prevent backdrop from blocking modal interactions */
    .modal.show {
        pointer-events: auto !important;
    }
    
    .modal.show .modal-dialog {
        pointer-events: auto !important;
    }
    
    .modal.show .modal-content {
        pointer-events: auto !important;
    }
    
    /* Ensure backdrop doesn't block clicks on modal */
    .modal-backdrop {
        pointer-events: auto !important;
    }
    
    /* Make sure modal is always above backdrop */
    body.modal-open .modal.show {
        z-index: 1055 !important;
    }
    
    body.modal-open .modal.show .modal-dialog {
        z-index: 1056 !important;
    }
    
    body.modal-open .modal.show .modal-content {
        z-index: 1057 !important;
    }
</style>

<div class="analytics-container">
    <div class="analytics-overlay">
        <!-- Header -->
        <div class="patient-header">
            <button class="back-button" onclick="window.location.href='@Url.Action("Index", "Patient")'">
                <i class="bi bi-arrow-left"></i>
            </button>
            <div class="patient-info">
                <div class="patient-name">@Model.Patient.FullName</div>
                <div style="font-size: 0.9rem; color: #aaa;">@(Model.Patient.PatientId ?? "No Patient ID")</div>
            </div>
        </div>

        <!-- Patient Information Card -->
        <div class="case-input-card mb-4">
            <h2 class="section-title">Patient Information</h2>
            <div class="row">
                <div class="col-md-3 text-center mb-3">
                    @if (!string.IsNullOrEmpty(Model.ProfileImageDataUrl))
                    {
                        <img src="@Model.ProfileImageDataUrl" alt="Profile" style="width: 150px; height: 150px; border-radius: 50%; object-fit: cover; border: 3px solid #007bff;" />
                    }
                    else
                    {
                        <div style="width: 150px; height: 150px; border-radius: 50%; background: #6c757d; display: flex; align-items: center; justify-content: center; color: white; font-size: 3rem; font-weight: bold; margin: 0 auto;">
                            @Model.Patient.FirstName[0]@Model.Patient.LastName[0]
                        </div>
                    }
                </div>
                <div class="col-md-9">
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <strong>Date of Birth:</strong> @Model.Patient.DateOfBirth.ToString("yyyy-MM-dd")
                        </div>
                        <div class="col-md-6 mb-2">
                            <strong>Gender:</strong> @Model.Patient.Gender
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Patient.Email))
                        {
                            <div class="col-md-6 mb-2">
                                <strong>Email:</strong> @Model.Patient.Email
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Patient.PhoneNumber))
                        {
                            <div class="col-md-6 mb-2">
                                <strong>Phone:</strong> @Model.Patient.PhoneNumber
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Patient.Address))
                        {
                            <div class="col-md-12 mb-2">
                                <strong>Address:</strong> @Model.Patient.Address
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Patient.Allergies))
                        {
                            <div class="col-md-6 mb-2">
                                <strong>Allergies:</strong> @Model.Patient.Allergies
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Patient.CurrentMedications))
                        {
                            <div class="col-md-6 mb-2">
                                <strong>Current Medications:</strong> @Model.Patient.CurrentMedications
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Patient.MedicalHistorySummary))
                        {
                            <div class="col-md-12 mb-2">
                                <strong>Medical History:</strong> @Model.Patient.MedicalHistorySummary
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Medical Scans Section -->
        <div class="case-input-card mb-4">
           @*  <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="section-title mb-0">Medical Scans</h2>
                <button class="btn btn-primary" onclick="showUploadScanModal()">
                    <i class="bi bi-plus-circle"></i> Upload Scan
                </button>
            </div> *@

            @if (Model.Scans.Any())
            {
                <div class="row">
                    @foreach (var scan in Model.Scans)
                    {
                        <div class="col-md-6 mb-4">
                            <div class="card">
                                <div class="card-header d-flex justify-content-between">
                                    <span><strong>@scan.ScanType</strong> - @scan.ScanDate.ToString("yyyy-MM-dd HH:mm")</span>
                                    <span class="badge bg-info">@scan.FileName</span>
                                </div>
                                <div class="card-body">
                                    @if (!string.IsNullOrEmpty(scan.ImageDataUrl))
                                    {
                                        <img src="@scan.ImageDataUrl" alt="@scan.ScanType" class="img-fluid mb-3" style="max-height: 300px; width: 100%; object-fit: contain;" />
                                    }
                                    
                                    @if (!string.IsNullOrEmpty(scan.LinkedModels))
                                    {
                                        <div class="mb-2">
                                            <strong>Linked Models:</strong> 
                                            <span class="badge bg-success">@scan.LinkedModels</span>
                                        </div>
                                    }
                                    
                                    @if (!string.IsNullOrEmpty(scan.GeneratedResult))
                                    {
                                        <div class="alert alert-info">
                                            <strong>Generated Result:</strong>
                                            <pre style="white-space: pre-wrap; margin: 0;">@scan.GeneratedResult</pre>
                                            @if (scan.ResultGeneratedAt.HasValue)
                                            {
                                                <small class="text-muted">Generated: @scan.ResultGeneratedAt.Value.ToString("yyyy-MM-dd HH:mm")</small>
                                            }
                                        </div>
                                    }
                                    
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-primary link-models-btn" 
                                                data-patient-id="@Model.Patient.Id" 
                                                data-scan-id="@scan.Id" 
                                                data-scan-type="@scan.ScanType">
                                            <i class="bi bi-link"></i> Link AI Models
                                        </button>
                                        @if (string.IsNullOrEmpty(scan.GeneratedResult))
                                        {
                                            <button class="btn btn-sm btn-success generate-result-btn" 
                                                    data-patient-id="@Model.Patient.Id" 
                                                    data-scan-id="@scan.Id">
                                                <i class="bi bi-magic"></i> Generate Result
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="bi bi-image" style="font-size: 2rem; color: #6c757d;"></i>
                    <p class="mt-2">No scans uploaded yet.</p>
                </div>
            }
        </div>

        <!-- History Section -->
        <div class="case-input-card">
            <h2 class="section-title">Medical History</h2>
            @if (Model.HistoryEntries.Any())
            {
                <div class="list-group">
                    @foreach (var history in Model.HistoryEntries)
                    {
                        <div class="list-group-item mb-3">
                            <div class="d-flex justify-content-between mb-2">
                                <h5>@history.VisitType - @history.VisitDate.ToString("yyyy-MM-dd HH:mm")</h5>
                            </div>
                            @if (!string.IsNullOrEmpty(history.ChiefComplaint))
                            {
                                <p><strong>Chief Complaint:</strong> @history.ChiefComplaint</p>
                            }
                            @if (!string.IsNullOrEmpty(history.ConditionDescription))
                            {
                                <p><strong>Condition:</strong> @history.ConditionDescription</p>
                            }
                            @if (!string.IsNullOrEmpty(history.ClinicalNotes))
                            {
                                <p><strong>Clinical Notes:</strong> @history.ClinicalNotes</p>
                            }
                            @if (!string.IsNullOrEmpty(history.Diagnosis))
                            {
                                <p><strong>Diagnosis:</strong> @history.Diagnosis</p>
                            }
                            @if (!string.IsNullOrEmpty(history.TreatmentPlan))
                            {
                                <p><strong>Treatment Plan:</strong> @history.TreatmentPlan</p>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="bi bi-clock-history" style="font-size: 2rem; color: #6c757d;"></i>
                    <p class="mt-2">No history entries yet.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Upload Scan Modal -->
<div class="modal fade" id="uploadScanModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Upload Medical Scan</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="uploadScanForm">
                    <input type="hidden" id="uploadPatientId" value="@Model.Patient.Id" />
                    <div class="mb-3">
                        <label class="form-label">Scan Type</label>
                        <select id="uploadScanType" class="form-control" required>
                            <option value="">Select Scan Type</option>
                            <option value="XRay">X-Ray</option>
                            <option value="CTScan">CT Scan</option>
                            <option value="MRI">MRI</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Scan File</label>
                        <input type="file" id="uploadScanFile" class="form-control" accept="image/png,image/jpeg,application/dicom,.dcm,.dicm" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Condition Description (Optional)</label>
                        <textarea id="uploadConditionText" class="form-control" rows="3"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="uploadScan()">Upload</button>
            </div>
        </div>
    </div>
</div>

<!-- Link Models Modal -->
<div class="modal fade" id="linkModelsModal" tabindex="-1" aria-labelledby="linkModelsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="linkModelsModalLabel">
                    <i class="bi bi-link-45deg"></i> Link AI Models to Scan
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="closeModalBtn"></button>
            </div>
            <div class="modal-body" style="padding: 1.5rem;">
                <form id="linkModelsForm">
                    <input type="hidden" id="linkPatientId" />
                    <input type="hidden" id="linkScanId" />
                    
                    <!-- Instructions -->
                    <div class="alert alert-primary mb-4" role="alert">
                        <h6 class="alert-heading"><i class="bi bi-info-circle-fill"></i> Instructions</h6>
                        <p class="mb-0" id="modelInfoText">The appropriate AI model for your scan type has been automatically selected. Click <strong>"Link Models"</strong> to proceed, or select additional models if needed.</p>
                    </div>
                    
                    <!-- Model Selection -->
                    <div class="mb-4">
                        <label class="form-label fw-bold mb-3">
                            <i class="bi bi-check2-square"></i> Select AI Models to Link:
                        </label>
                        
                        <div class="card mb-2" id="chexnetCard" style="border: 2px solid #e0e0e0;">
                            <div class="card-body p-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="modelCheXNet" value="CheXNet" onchange="updateModelSelection()" style="width: 20px; height: 20px; cursor: pointer;">
                                    <label class="form-check-label ms-2" for="modelCheXNet" style="cursor: pointer; width: 100%;">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong class="text-primary">CheXNet</strong>
                                                <small class="text-muted d-block">For X-Ray chest image analysis</small>
                                            </div>
                                            <span class="badge bg-success" id="chexnetBadge" style="display:none;">
                                                <i class="bi bi-check-circle"></i> Selected
                                            </span>
                                        </div>
                                    </label>
                                </div>
                            </div>
                        </div>
                        
                        <div class="card mb-2" id="biobertCard" style="border: 2px solid #e0e0e0;">
                            <div class="card-body p-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="modelBioBert" value="BioBert" onchange="updateModelSelection()" style="width: 20px; height: 20px; cursor: pointer;">
                                    <label class="form-check-label ms-2" for="modelBioBert" style="cursor: pointer; width: 100%;">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong class="text-primary">BioBert</strong>
                                                <small class="text-muted d-block">For clinical text analysis (optional)</small>
                                            </div>
                                            <span class="badge bg-success" id="biobertBadge" style="display:none;">
                                                <i class="bi bi-check-circle"></i> Selected
                                            </span>
                                        </div>
                                    </label>
                                </div>
                            </div>
                        </div>
                        
                        <div class="card mb-3" id="lungaiCard" style="border: 2px solid #e0e0e0;">
                            <div class="card-body p-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="modelLungAI" value="LungAI" onchange="updateModelSelection()" style="width: 20px; height: 20px; cursor: pointer;">
                                    <label class="form-check-label ms-2" for="modelLungAI" style="cursor: pointer; width: 100%;">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong class="text-primary">LungAI</strong>
                                                <small class="text-muted d-block">For CT Scan chest analysis</small>
                                            </div>
                                            <span class="badge bg-success" id="lungaiBadge" style="display:none;">
                                                <i class="bi bi-check-circle"></i> Selected
                                            </span>
                                        </div>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Clinical Text Input -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            <i class="bi bi-text-paragraph"></i> Clinical Text (Optional - for BioBert):
                        </label>
                        <textarea id="linkClinicalText" class="form-control" rows="3" placeholder="Enter patient symptoms, clinical notes, or condition description here..."></textarea>
                        <small class="text-muted">This text will be analyzed by BioBert if selected above.</small>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-lg" id="cancelLinkBtn" data-bs-dismiss="modal" style="min-width: 120px; cursor: pointer;">
                    <i class="bi bi-x-circle"></i> Cancel
                </button>
                <button type="button" class="btn btn-primary btn-lg" id="linkModelsBtn" style="min-width: 180px; font-weight: bold; cursor: pointer;">
                    <i class="bi bi-link-45deg"></i> <span id="linkBtnText">Link Models</span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Global backdrop monitor - watches for unwanted backdrop creation
        let backdropMonitor = null;
        function startBackdropMonitor() {
            if (backdropMonitor) {
                backdropMonitor.disconnect(); // Disconnect old one if exists
            }
            
            backdropMonitor = new MutationObserver(function(mutations) {
                mutations.forEach(function(mutation) {
                    if (mutation.addedNodes.length > 0) {
                        mutation.addedNodes.forEach(function(node) {
                            if (node.nodeType === 1 && node.classList && node.classList.contains('modal-backdrop')) {
                                // Small delay to let Bootstrap finish its setup
                                setTimeout(function() {
                                    const allBackdrops = document.querySelectorAll('.modal-backdrop');
                                    console.log(`Backdrop monitor: Detected backdrop. Total: ${allBackdrops.length}`);
                                    
                                    // Remove ALL backdrops for linkModelsModal - backdrop causes blocking
                                    const linkModal = document.getElementById('linkModelsModal');
                                    if (linkModal && linkModal.classList.contains('show')) {
                                        console.log(`Removing ALL ${allBackdrops.length} backdrop(s) - backdrop disabled for linkModelsModal`);
                                        allBackdrops.forEach(backdrop => {
                                            backdrop.remove();
                                        });
                                        // Clean up body classes
                                        document.body.classList.remove('modal-open');
                                        document.body.style.overflow = '';
                                        document.body.style.paddingRight = '';
                                    }
                                }, 10);
                            }
                        });
                    }
                });
            });
            
            backdropMonitor.observe(document.body, {
                childList: true,
                subtree: false
            });
            
            console.log('Backdrop monitor started');
        }
        
        // Start monitoring on page load
        document.addEventListener('DOMContentLoaded', function() {
            startBackdropMonitor();
        });
        
        // Use event delegation for dynamically rendered buttons
        document.addEventListener('DOMContentLoaded', function() {
            // Handle Link AI Models button clicks
            document.addEventListener('click', function(e) {
                if (e.target.closest('.link-models-btn')) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    const btn = e.target.closest('.link-models-btn');
                    const patientId = btn.getAttribute('data-patient-id');
                    const scanId = btn.getAttribute('data-scan-id');
                    const scanType = btn.getAttribute('data-scan-type');
                    
                    console.log('=== Link AI Models button clicked ===');
                    
                    // Close uploadScanModal and remove its backdrop before opening linkModelsModal
                    closeUploadScanModal();
                    
                    // Wait a bit to ensure cleanup completes before opening new modal
                    setTimeout(() => {
                        // Aggressive cleanup - remove ALL backdrops
                        const remainingBackdrops = document.querySelectorAll('.modal-backdrop');
                        if (remainingBackdrops.length > 0) {
                            console.log('Pre-open cleanup: Removing all backdrops:', remainingBackdrops.length);
                            remainingBackdrops.forEach(backdrop => {
                                backdrop.remove();
                            });
                        }
                        
                        // Ensure body is completely clean
                        document.body.classList.remove('modal-open');
                        document.body.style.overflow = '';
                        document.body.style.paddingRight = '';
                        document.body.style.removeProperty('overflow');
                        document.body.style.removeProperty('padding-right');
                        
                        // Now open the Link AI Models modal
                        openLinkModelsModal(patientId, scanId, scanType);
                    }, 150);
                }
                
                if (e.target.closest('.generate-result-btn')) {
                    const btn = e.target.closest('.generate-result-btn');
                    const patientId = btn.getAttribute('data-patient-id');
                    const scanId = btn.getAttribute('data-scan-id');
                    generateResult(patientId, scanId);
                }
            });
            
            // Set up modal button event listeners
            setupModalButtons();
        });
        
        function setupModalButtons() {
            console.log('Setting up modal buttons...');
            
            // Link Models button - use both onclick and event listener
            const linkBtn = document.getElementById('linkModelsBtn');
            if (linkBtn) {
                console.log('Link button found, setting up handlers');
                
                // Remove existing handlers
                linkBtn.onclick = null;
                linkBtn.removeAttribute('onclick');
                
                // Add onclick handler
                linkBtn.onclick = function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    console.log('Link Models button clicked (onclick)');
                    if (typeof window.linkModels === 'function') {
                        window.linkModels();
                    } else {
                        alert('Error: Function not found. Please refresh the page.');
                    }
                    return false;
                };
                
                // Also add event listener as backup (remove old ones first)
                const newLinkBtn = linkBtn.cloneNode(true);
                linkBtn.parentNode.replaceChild(newLinkBtn, linkBtn);
                
                // Set onclick
                newLinkBtn.onclick = function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    console.log('Link Models button clicked');
                    if (typeof window.linkModels === 'function') {
                        window.linkModels();
                    } else {
                        alert('Error: Function not found. Please refresh the page.');
                    }
                    return false;
                };
                
                // Add event listener
                newLinkBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    console.log('Link Models button clicked (event listener)');
                    if (typeof window.linkModels === 'function') {
                        window.linkModels();
                    }
                });
                
                console.log('Link button setup complete');
            } else {
                console.error('Link button not found!');
            }
            
            // Cancel button - Bootstrap handles it via data-bs-dismiss
            // Just ensure it's clickable
            const cancelBtn = document.getElementById('cancelLinkBtn');
            if (cancelBtn) {
                cancelBtn.style.cursor = 'pointer';
                cancelBtn.style.pointerEvents = 'auto';
            }
        }
        
        // Define the actual reset function first (before it's used)
        const actualResetFunction = function() {
            // Reset checkboxes when modal is closed
            const chexnet = document.getElementById('modelCheXNet');
            const biobert = document.getElementById('modelBioBert');
            const lungai = document.getElementById('modelLungAI');
            const linkBtn = document.getElementById('linkModelsBtn');
            
            if (chexnet) {
                chexnet.checked = false;
                chexnet.disabled = false;
            }
            if (biobert) {
                biobert.checked = false;
                biobert.disabled = false;
            }
            if (lungai) {
                lungai.checked = false;
                lungai.disabled = false;
            }
            
            const clinicalText = document.getElementById('linkClinicalText');
            if (clinicalText) clinicalText.value = '';
            
            // Reset button
            if (linkBtn) {
                linkBtn.disabled = false;
                linkBtn.classList.remove('btn-success', 'btn-secondary');
                linkBtn.classList.add('btn-primary');
                const linkBtnText = document.getElementById('linkBtnText');
                if (linkBtnText) {
                    linkBtnText.textContent = 'Link Models';
                } else {
                    linkBtn.innerHTML = '<i class="bi bi-link-45deg"></i> Link Models';
                }
            }
            
            updateModelSelection();
        };
        
        // Set up modal close handler once on page load (only one listener)
        let modalCloseHandlerSetup = false;
        document.addEventListener('DOMContentLoaded', function() {
            if (!modalCloseHandlerSetup) {
                modalCloseHandlerSetup = true;
                const modalElement = document.getElementById('linkModelsModal');
                if (modalElement) {
                    modalElement.addEventListener('hidden.bs.modal', function() {
                        console.log('Modal closed, resetting...');
                        actualResetFunction();
                    }, { once: false });
                }
            }
        });
        
        // Ensure functions are available immediately
        if (typeof linkModels === 'undefined') {
            // Will be defined below
        }

        function showUploadScanModal() {
            const modal = new bootstrap.Modal(document.getElementById('uploadScanModal'));
            modal.show();
        }
        
        function closeUploadScanModal() {
            console.log('=== Cleaning up uploadScanModal ===');
            
            // Close the uploadScanModal if it's open
            const uploadModalElement = document.getElementById('uploadScanModal');
            if (uploadModalElement) {
                const uploadModal = bootstrap.Modal.getInstance(uploadModalElement);
                if (uploadModal) {
                    console.log('Hiding uploadScanModal instance');
                    uploadModal.hide();
                    
                    // Wait for Bootstrap's hide animation, then dispose
                    setTimeout(() => {
                        uploadModal.dispose();
                        
                        // Clean up modal element
                        uploadModalElement.classList.remove('show', 'fade');
                        uploadModalElement.style.display = 'none';
                        uploadModalElement.setAttribute('aria-hidden', 'true');
                        uploadModalElement.removeAttribute('aria-modal');
                        uploadModalElement.removeAttribute('role');
                        
                        // Remove ALL backdrop elements
                        const backdrops = document.querySelectorAll('.modal-backdrop');
