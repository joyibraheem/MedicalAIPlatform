                }
                
                // Store scan type in a data attribute for later use
                modalElement.setAttribute('data-scan-type', scanType || '');
                modalElement.setAttribute('data-patient-id', patientId);
                modalElement.setAttribute('data-scan-id', scanId);
                
                // Set hidden inputs
                const patientIdInput = document.getElementById('linkPatientId');
                const scanIdInput = document.getElementById('linkScanId');
