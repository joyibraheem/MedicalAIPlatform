@model MedicalAIPlatform.Models.FollowUpViewModel
@{
    ViewData["Title"] = "Follow Up";
    Layout = "_DoctorLayout"; 
}

<link rel="stylesheet" href="~/css/followup.css" asp-append-version="true" />

<!-- Page Content -->
<div class="page-title-section">
    <h1 class="page-title-main" data-i18n="followup_title">Patient Follow-Up & Monitoring</h1>
    <p class="page-subtitle" data-i18n="followup_subtitle">Manage post-scan actions and AI-driven recommendations</p>
</div>

<!-- Stats Row -->
<div class="stats-grid">
    
    <!-- Compliance Rate -->
    <div class="stat-card">
        <div>
            <div class="stat-label" data-i18n="followup_compliance_rate">Compliance Rate</div>
            <div class="stat-value-big">@Model.ComplianceRate%</div>
        </div>
        <div class="progress-circle" data-percent="@Model.ComplianceRate%" style="--percent: @(Model.ComplianceRate * 3.6)deg"></div>
    </div>

    <!-- Urgent Cases -->
    <div class="stat-card">
        <div class="stat-label" data-i18n="followup_high_urgency">High Urgency cases</div>
        <div class="stat-value-big text-danger-custom">@Model.HighUrgencyCases.ToString("00")</div>
        <div class="stat-subtext" data-i18n="followup_immediate_referral">Requiring immediate referral</div>
    </div>

    <!-- Scheduled Today -->
    <div class="stat-card">
        <div class="stat-label" data-i18n="followup_scheduled_today">Scheduled Today</div>
        <div class="stat-value-big text-blue-custom">@Model.ScheduledToday.ToString("00")</div>
        <div class="avatar-group">
            <div class="avatar-circle"></div>
            <div class="avatar-circle"></div>
            <div class="avatar-circle"></div>
            <div class="avatar-circle" style="background:none; display:flex; align-items:center; justify-content:center; color:#64748b; font-size:0.8rem; font-weight:600;">+5</div>
        </div>
    </div>

</div>

<!-- Patient List -->
<div class="patient-list">
        @foreach(var patient in Model.Patients)
    {
        <div class="patient-card">
            <div class="patient-info">
                <h5>@patient.Name</h5>
                <p><span data-i18n="followup_pid">PID:</span> @patient.PID</p>
            </div>
            <div>
                @{
                    var badgeClass = patient.UrgencyLevel switch {
                        "High" => "urgency-high",
                        "Medium" => "urgency-medium",
                        "Low" => "urgency-low",
                        _ => "urgency-low"
                    };
                }
                <div class="urgency-badge @badgeClass" data-urgency-level="@patient.UrgencyLevel.ToLower()">@patient.UrgencyLevel</div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.body.classList.add('followup-page');
        
        // Localize urgency levels
        function localizeUrgencyLevels(lang) {
            document.querySelectorAll('.urgency-badge[data-urgency-level]').forEach(el => {
                const level = el.getAttribute('data-urgency-level');
                const translationKey = `urgency_${level}`;
                const translations = window.calendarTranslations || {};
                if (translations[lang] && translations[lang][translationKey]) {
                    el.textContent = translations[lang][translationKey];
                }
            });
        }
        
        // Listen for language changes via custom event
        document.addEventListener('languageChanged', function(event) {
            const lang = event.detail.lang || 'en';
            localizeUrgencyLevels(lang);
        });
        
        // Also listen for lang attribute changes
        const observer = new MutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
                if (mutation.type === 'attributes' && mutation.attributeName === 'lang') {
                    const lang = document.documentElement.lang || 'en';
                    localizeUrgencyLevels(lang);
                }
            });
        });
        
        observer.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ['lang']
        });
        
        // Initial localization - FORCE English by default
        const savedPrefs = localStorage.getItem('medicalAiPrefs');
        let initialLang = 'en';
        if (savedPrefs) {
            try {
                const prefs = JSON.parse(savedPrefs);
                if (prefs.language === 'ar') {
                    initialLang = 'ar';
                }
            } catch (e) {
                // Default to English on error
            }
        }
        
        // Ensure HTML attributes are set correctly
        document.documentElement.lang = initialLang;
        document.documentElement.dir = initialLang === 'ar' ? 'rtl' : 'ltr';
        
        localizeUrgencyLevels(initialLang);
    </script>
}
