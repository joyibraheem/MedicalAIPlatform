@model MedicalAIPlatform.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <script>
        (function () {
            const theme = localStorage.getItem("theme");
            document.documentElement.setAttribute(
                "data-theme",
                theme === "dark" ? "dark" : "light"
            );
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MedicalAIPlatform</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <style>
        #darkOverlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.75);
            z-index: 9998;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.25s ease;
        }

        html[data-theme="dark"] #darkOverlay {
            opacity: 1;
        }
    </style>
</head>
<body>
    <div id="darkOverlay"></div>

    <div class="auth-card">
        
        <div class="auth-header">
            <div class="auth-icon-circle">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-arrow-counterclockwise" viewBox="0 0 16 16" style="color: #1D4581;">
                    <path fill-rule="evenodd" d="M8 3a5 5 0 1 1-4.546 2.914.5.5 0 0 0-.908-.417A6 6 0 1 0 8 2v1z"/>
                    <path d="M8 4.466V.534a.25.25 0 0 0-.41-.192L5.23 2.308a.25.25 0 0 0 0 .384l2.36 1.966A.25.25 0 0 0 8 4.466z"/>
                </svg>
            </div>
            
            <h1 class="auth-title-large" style="margin-bottom: 5px;">Forgot Password</h1>
            <p class="auth-subtitle-small">Enter your registered email to receive a<br>verification code for your ChestScan<br>account</p>
        </div>

        <form asp-action="ForgotPassword" method="post" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

            <!-- Email Address -->
            <div class="form-group">
                <label asp-for="Email" class="auth-label">Email Address</label>
                <div class="input-wrapper">
                    <!-- Icon on the RIGHT -->
                    <input asp-for="Email" class="form-control-custom form-control-icon-right" placeholder="name@hospital.com" />
                     <span class="form-icon form-icon-right">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-envelope" viewBox="0 0 16 16">
                            <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.708 2.825L15 11.105V5.383Zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741ZM1 11.105l4.708-2.897L1 5.383v5.722Z"/>
                        </svg>
                    </span>
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn-auth btn-primary-auth">Confirm</button>
        </form>

        <div class="auth-footer mt-4">
             <a asp-action="Login" class="back-to-login">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chevron-left" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z"/>
                </svg>
                Back to Login
            </a>
        </div>

    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
