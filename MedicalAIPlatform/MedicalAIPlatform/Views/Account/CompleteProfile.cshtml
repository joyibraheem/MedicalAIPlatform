@model MedicalAIPlatform.Models.CompleteDoctorProfileViewModel
@{
    ViewData["Title"] = "Complete Doctor Profile";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Medical AI Platform</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <style>
        .auth-card { max-width: 520px; }
        body { align-items: flex-start; padding: 2rem 1rem; min-height: 100vh; height: auto; }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-icon-circle">
                <i class="bi bi-person-badge fs-4"></i>
            </div>
            <h1 class="auth-title-large">Complete your profile</h1>
            <p class="auth-subtitle-small">Submit your credentials for administrator review before accessing clinical features.</p>
        </div>

        <form asp-action="CompleteProfile" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

            <div class="form-group mb-3">
                <label asp-for="FullName" class="auth-label"></label>
                <input asp-for="FullName" class="form-control-custom w-100" placeholder="Dr. Jane Smith" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Specialization" class="auth-label"></label>
                <input asp-for="Specialization" class="form-control-custom w-100" placeholder="Radiology, Cardiology…" />
                <span asp-validation-for="Specialization" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="HospitalOrganization" class="auth-label"></label>
                <input asp-for="HospitalOrganization" class="form-control-custom w-100" placeholder="City General Hospital" />
                <span asp-validation-for="HospitalOrganization" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="MedicalLicenseNumber" class="auth-label"></label>
                <input asp-for="MedicalLicenseNumber" class="form-control-custom w-100" placeholder="License / registration ID" />
                <span asp-validation-for="MedicalLicenseNumber" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PhoneNumber" class="auth-label"></label>
                <input asp-for="PhoneNumber" class="form-control-custom w-100" placeholder="+1 555 0100" />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="RegistrationNotes" class="auth-label"></label>
                <textarea asp-for="RegistrationNotes" class="form-control-custom w-100" rows="3" placeholder="Optional context for the credentialing team"></textarea>
                <span asp-validation-for="RegistrationNotes" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn-auth btn-primary-custom w-100 mt-2">Submit for review</button>
        </form>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
