@model MedicalAIPlatform.Models.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <script>
        (function () {
            const theme = localStorage.getItem("theme");
            document.documentElement.setAttribute(
                "data-theme",
                theme === "dark" ? "dark" : "light"
            );
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MedicalAIPlatform</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
    <style>
        #darkOverlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.75);
            z-index: 9998;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.25s ease;
        }

        html[data-theme="dark"] #darkOverlay {
            opacity: 1;
        }
    </style>
</head>
<body>
    <div id="darkOverlay"></div>

    <div class="auth-card">
        
        <div class="auth-header">
            <div class="auth-icon-circle">
                <img src="~/images/chest-icon.png" alt="ChestAI" style="width: 32px; height: 32px;" />
            </div>
            
            <h1 class="auth-title-large">Create Account</h1>
            <p class="auth-subtitle-small">Join our AI-powered Chest cancer<br>screening platform</p>
        </div>

        <form asp-action="Register" method="post" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

            <!-- Full Name -->
            <div class="form-group">
                <label asp-for="FullName" class="auth-label">Full Name</label>
                <div class="input-wrapper">
                    <span class="form-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person" viewBox="0 0 16 16">
                            <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0Zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4Zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10Z"/>
                        </svg>
                    </span>
                    <input asp-for="FullName" class="form-control-custom" placeholder="Enter your Full Name" />
                </div>
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <!-- Email -->
            <div class="form-group">
                <label asp-for="Email" class="auth-label">Email</label>
                <div class="input-wrapper">
                    <span class="form-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-envelope" viewBox="0 0 16 16">
                            <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.708 2.825L15 11.105V5.383Zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741ZM1 11.105l4.708-2.897L1 5.383v5.722Z"/>
                        </svg>
                    </span>
                    <input asp-for="Email" class="form-control-custom" placeholder="Enter your Email" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <!-- Specialization & Verification Code (Grouped or separate) -->
            <!-- Keeping separate to match style -->
            <div class="row">
                <div class="col-md-6 pr-1">
                    <div class="form-group">
                        <label asp-for="Specialization" class="auth-label">Specialization</label>
                        <div class="input-wrapper">
                            <span class="form-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-briefcase" viewBox="0 0 16 16">
                                    <path d="M6.5 1A1.5 1.5 0 0 0 5 2.5V3H1.5A1.5 1.5 0 0 0 0 4.5v8A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5v-8A1.5 1.5 0 0 0 14.5 3H11v-.5A1.5 1.5 0 0 0 9.5 1h-3zm0 1h3a.5.5 0 0 1 .5.5V3H6v-.5a.5.5 0 0 1 .5-.5zm1.886 6.914L15 7.151V12.5a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5V7.15l6.614 1.764a1.5 1.5 0 0 0 .772 0zM1.5 4h13a.5.5 0 0 1 .5.5v1.616L8.129 7.948a.5.5 0 0 1-.258 0L1 6.116V4.5a.5.5 0 0 1 .5-.5z"/>
                                </svg>
                            </span>
                            <input asp-for="Specialization" class="form-control-custom" placeholder="Specialization" />
                        </div>
                        <span asp-validation-for="Specialization" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6 pl-1">
                    <div class="form-group">
                         <label asp-for="DoctorVerificationCode" class="auth-label">Code</label>
                         <div class="input-wrapper">
                            <span class="form-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-shield-lock" viewBox="0 0 16 16">
                                    <path d="M5.338 1.59a61.44 61.44 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.725 10.725 0 0 0 2.287 2.233c.346.244.652.42.893.533.12.057.218.095.293.118a.55.55 0 0 0 .101.025.615.615 0 0 0 .1-.025c.076-.023.174-.061.294-.118.24-.113.547-.29.893-.533a10.726 10.726 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.23-4.94-1.258-4.94-1.258a.48.48 0 0 0-.08-.016.48.48 0 0 0-.39.202l-.5 2a.48.48 0 1 0 .932.362L9.29 2.508l.386 1.544a.48.48 0 1 0 .932-.362l.5-2a.48.48 0 0 0-.39-.202c-.027 0-.054.005-.08.016l-2.001.5-2.091-.527z"/>
                                    <path d="M9.5 6.5a1.5 1.5 0 0 1-1 2.829V14a1.5 1.5 0 1 1-3 0V9.329a1.5 1.5 0 0 1-1-2.829 1.5 1.5 0 0 1 2 0h1a1.5 1.5 0 0 1 2 0z"/>
                                </svg>
                            </span>
                            <input asp-for="DoctorVerificationCode" class="form-control-custom" placeholder="Code" type="password"/>
                        </div>
                        <span asp-validation-for="DoctorVerificationCode" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <!-- Password -->
            <div class="form-group">
                <label asp-for="Password" class="auth-label">Password</label>
                <div class="input-wrapper">
                    <span class="form-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-lock" viewBox="0 0 16 16">
                            <path d="M8 1a2 2 0 0 1 2-2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2zM5 8h6a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z"/>
                        </svg>
                    </span>
                    <input asp-for="Password" type="password" class="form-control-custom" placeholder="Create a Password" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <!-- Confirm Password -->
            <div class="form-group">
                <label asp-for="ConfirmPassword" class="auth-label">Confirm Password</label>
                <div class="input-wrapper">
                    <span class="form-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-lock" viewBox="0 0 16 16">
                            <path d="M8 1a2 2 0 0 1 2-2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2zM5 8h6a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z"/>
                        </svg>
                    </span>
                    <input asp-for="ConfirmPassword" type="password" class="form-control-custom" placeholder="Confirm Your Password" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn-auth btn-primary-auth">Create Account</button>
        </form>

        <div class="auth-footer mb-3">
            already have an account? <a asp-action="Login">sign in</a>
        </div>

        <!-- Google Login -->
        <form asp-action="ExternalLogin" method="post">
             <button type="submit" name="provider" value="Google" class="btn-auth btn-google">
                <svg width="18" height="18" viewBox="0 0 18 18">
                    <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z"/>
                    <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.258c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z"/>
                    <path fill="#FBBC05" d="M3.964 10.712c-.18-.54-.282-1.117-.282-1.712 0-.595.102-1.172.282-1.712V4.956H.957C.347 6.173 0 7.55 0 9c0 1.45.348 2.827.957 4.044l3.007-2.332z"/>
                    <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.956L3.964 7.288C4.672 5.163 6.656 3.58 9 3.58z"/>
                </svg>
                Continue with Google
            </button>
        </form>

    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
