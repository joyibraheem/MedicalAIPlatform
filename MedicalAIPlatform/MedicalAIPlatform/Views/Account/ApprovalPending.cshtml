@model MedicalAIPlatform.Models.ApprovalPendingViewModel
@using MedicalAIPlatform.Models
@{
    ViewData["Title"] = Model.Status == DoctorRegistrationStatuses.Rejected ? "Registration Rejected" : "Approval Pending";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Medical AI Platform</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-card text-center">
        @if (Model.Status == DoctorRegistrationStatuses.Rejected)
        {
            <div class="auth-icon-circle mx-auto mb-3" style="background:#fee2e2;color:#b91c1c;">
                <i class="bi bi-x-circle fs-3"></i>
            </div>
            <h1 class="auth-title-large">Registration rejected</h1>
            <p class="auth-subtitle-small">Your registration request was not approved.</p>
            @if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
            {
                <div class="alert alert-danger text-start mt-3 mb-0">
                    <strong>Reason:</strong> @Model.RejectionReason
                </div>
            }
        }
        else
        {
            <div class="auth-icon-circle mx-auto mb-3" style="background:#fef3c7;color:#b45309;">
                <i class="bi bi-clock-history fs-3"></i>
            </div>
            <h1 class="auth-title-large">Approval pending</h1>
            <p class="auth-subtitle-small">
                @if (Model.ProfileSubmitted)
                {
                    @:Your profile was submitted successfully. An administrator will review your credentials shortly.
                }
                else
                {
                    @:Please complete your doctor profile to begin the review process.
                }
            </p>
            <p class="small text-muted">Medical features remain locked until your account is verified.</p>
        }

        <div class="d-flex flex-column gap-2 mt-4">
            @if (Model.Status == DoctorRegistrationStatuses.Pending && !Model.ProfileSubmitted)
            {
                <a asp-action="CompleteProfile" class="btn-auth btn-primary-custom">Complete profile</a>
            }
            <form asp-action="Logout" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary w-100">Sign out</button>
            </form>
        </div>
    </div>
</body>
</html>
