@{
    ViewData["Title"] = "Access Denied";
}

<div class="container mt-5 text-center">
    <div class="card shadow-lg p-5 d-inline-block border-danger" style="max-width: 600px;">
        <h1 class="text-danger mb-4"><i class="bi bi-shield-lock-fill"></i> Access Denied</h1>
        <p class="lead text-muted">You do not have permission to view this resource.</p>
        <div class="mt-4">
             <a asp-controller="Home" asp-action="Index" class="btn btn-primary me-2">Go Home</a>
             <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-secondary">Log Out</a>
        </div>
    </div>
</div>
