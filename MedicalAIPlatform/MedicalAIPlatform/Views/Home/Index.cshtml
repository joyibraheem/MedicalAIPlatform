@using Microsoft.AspNetCore.Identity
@inject SignInManager<MedicalAIPlatform.Models.ApplicationUser> SignInManager
@inject UserManager<MedicalAIPlatform.Models.ApplicationUser> UserManager
@{
    ViewData["Title"] = "Multimodal-Medical-AI";
    var isAuthenticated = SignInManager.IsSignedIn(User);
}

@* 
    STRICT PALETTE RESTORATION
    - Colors: Reverted exactly to user specification (#1D4581, #127FEC, etc).
    - Design: Kept professional layout, typography, and "beautiful" structure.
    - Shadows/Gradients: Adjusted to work within the strict palette.
*@
</div>

<link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />

<script>
    // Initialize dark mode and language for landing page
    (function() {
        // Initialize theme
        const savedTheme = localStorage.getItem('theme');
        const prefs = localStorage.getItem('medicalAiPrefs') ? JSON.parse(localStorage.getItem('medicalAiPrefs')) : null;
        let isDarkMode = true; // Default to dark
        if (savedTheme === 'light' || savedTheme === 'dark') {
            isDarkMode = savedTheme === 'dark';
        } else if (prefs && typeof prefs.isDarkMode === 'boolean') {
            isDarkMode = prefs.isDarkMode;
        }
        document.documentElement.setAttribute('data-theme', isDarkMode ? 'dark' : 'light');
        
        // Initialize language
        const savedLang = localStorage.getItem('lang') || (prefs ? prefs.language : null) || 'en';
        document.documentElement.setAttribute('lang', savedLang);
        document.documentElement.setAttribute('dir', savedLang === 'ar' ? 'rtl' : 'ltr');
        
        // Apply language translations when i18n.js loads
        if (typeof window.setLanguage === 'function') {
            window.setLanguage(savedLang);
        }
    })();
</script>

@* --- NAVBAR (desktop ≥1200px) --- *@
<div class="nav-custom nav-custom-desktop">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <a href="/" class="brand-logo">
                 <img src="~/images/chest-icon.png" alt="ChestAI" style="width: 28px; height: 28px; margin-right: 8px;" />
            Multimodal-Medical-AI
        </a>
        <div class="d-flex align-items-center">
            @if (!isAuthenticated)
            {
                <a asp-controller="Account" asp-action="Login" class="btn-nav btn-nav-signin">Sign In</a>
                <a asp-controller="Account" asp-action="Register" class="btn-nav btn-nav-signup">Sign Up</a>
            }
            else
            {
                <a asp-controller="Dashboard" asp-action="Index" class="btn-nav btn-nav-signup">Dashboard</a>
            }
        </div>
    </div>
</div>

@* --- NAVBAR (tablet/mobile <1200px) --- *@
<nav class="nav-custom nav-custom-mobile navbar navbar-expand-lg">
    <div class="container-fluid">
        <a href="/" class="brand-logo navbar-brand">
             <img src="~/images/chest-icon.png" alt="ChestAI" width="28" height="28" style="margin-right: 8px;" />
            Multimodal-Medical-AI
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#homeNav"
                aria-controls="homeNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse justify-content-end" id="homeNav">
            <div class="d-flex align-items-center flex-wrap gap-2 py-2 py-lg-0">
            @if (!isAuthenticated)
            {
                <a asp-controller="Account" asp-action="Login" class="btn-nav btn-nav-signin">Sign In</a>
                <a asp-controller="Account" asp-action="Register" class="btn-nav btn-nav-signup">Sign Up</a>
            }
            else
            {
                <a asp-controller="Dashboard" asp-action="Index" class="btn-nav btn-nav-signup">Dashboard</a>
            }
            </div>
        </div>
    </div>
</nav>

