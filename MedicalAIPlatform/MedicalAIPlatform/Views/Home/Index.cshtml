        <div class="row g-3 justify-content-center">
            @{
                var specialties = new[] {
                    ("bi-heart-pulse", "Radiology"),
                    ("bi-lungs-fill", "Pulmonology"),
                    ("bi-hospital", "Emergency Medicine"),
                    ("bi-clipboard2-pulse", "Internal Medicine"),
                    ("bi-person-badge", "Primary Care"),
                    ("bi-activity", "Critical Care")
                };
            }
            @for (var i = 0; i < specialties.Length; i++)
            {
                var (icon, name) = specialties[i];
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="specialty-card mai-reveal" style="transition-delay:@(i * 0.05)s">
                        <i class="bi @icon"></i>
                        <span>@name</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

