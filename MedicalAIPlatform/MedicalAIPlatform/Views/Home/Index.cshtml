            <div class="col-md-4">
                <div class="testimonial-card mai-reveal mai-reveal-delay-2">
                    <div class="testimonial-stars"><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i></div>
                    <p class="testimonial-text">"The explainable AI reports make it easy to communicate findings to patients and referring physicians."</p>
                    <div class="testimonial-author">
                        <div class="testimonial-avatar">AP</div>
                        <div>
                            <strong>Dr. Anna Patel</strong>
                            <span>Pulmonologist, Regional Clinic</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* --- CTA --- *@
<section class="cta-section">
    <div class="container landing-container-wide">
        <div class="cta-glass mai-reveal">
            <h2>Ready to Transform Your Diagnostic Workflow?</h2>
            <p>Join hundreds of healthcare institutions leveraging AI-powered chest imaging analysis.</p>
            <div class="d-flex flex-wrap justify-content-center gap-3">
                @if (!isAuthenticated)
                {
                    <a asp-controller="Account" asp-action="Register" class="btn-hero btn-hero-start">Get Started Free</a>
                    <a asp-controller="Account" asp-action="Login" class="btn-hero btn-hero-demo">Sign In</a>
                }
                else
                {
                    <a asp-controller="Dashboard" asp-action="Index" class="btn-hero btn-hero-start">Open Dashboard</a>
                    <a asp-controller="Analytics" asp-action="Index" class="btn-hero btn-hero-demo">Upload Scan</a>
                }
            </div>
        </div>
    </div>
</section>

