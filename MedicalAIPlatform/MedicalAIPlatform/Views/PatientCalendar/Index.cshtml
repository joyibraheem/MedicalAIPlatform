@model IEnumerable<MedicalAIPlatform.Models.AppointmentViewModel>
@{
    ViewData["Title"] = "Calendar";
    Layout = "_DoctorLayout"; 
}

<link rel="stylesheet" href="~/css/calendar.css" asp-append-version="true" />

<!-- Page Content -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="page-title mb-0" data-i18n="calendar_schedule">Schedule</h1>
    <button class="btn btn-primary rounded-pill px-4" data-i18n="calendar_new_appointment">+ New Appointment</button>
</div>

<div class="calendar-layout">
    
    <!-- Left: Visual Calendar -->
    <div class="calendar-widget">
        <div class="month-header">
            <button class="btn-nav">&lt;</button>
            <div class="month-name" id="calendar-month-name">January 2026</div>
            <button class="btn-nav">&gt;</button>
        </div>
        
        <div class="days-grid" id="calendar-days-grid">
            <div class="day-label" data-i18n="day_sun">Sun</div>
            <div class="day-label" data-i18n="day_mon">Mon</div>
            <div class="day-label" data-i18n="day_tue">Tue</div>
            <div class="day-label" data-i18n="day_wed">Wed</div>
            <div class="day-label" data-i18n="day_thu">Thu</div>
            <div class="day-label" data-i18n="day_fri">Fri</div>
            <div class="day-label" data-i18n="day_sat">Sat</div>
            <!-- Calendar days will be generated dynamically by JavaScript -->
        </div>
    </div>

    <!-- Right: Upcoming Appointments -->
    <div class="appointments-widget">
        <h4 style="font-size:1.1rem; margin-bottom:1.5rem; font-weight:600;" data-i18n="calendar_upcoming">Upcoming</h4>
        
        @foreach (var item in Model.OrderBy(x => x.AppointmentTime))
        {
            <div class="apt-card" data-appointment-id="@item.Id">
                <div class="apt-time" data-appointment-time="@item.AppointmentTime.ToString("O")">@item.AppointmentTime.ToString("MMM dd, hh:mm tt")</div>
                <div class="apt-title">@item.PatientName</div>
                <div class="apt-type" data-appointment-type="@item.Type.ToLower()">@item.Type</div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="text-muted text-center py-4" data-i18n="calendar_no_appointments">No upcoming appointments</div>
        }
    </div>

</div>

@section Scripts {
    <script>
        document.body.classList.add('calendar-page');
        
        // Get today's date for comparison
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        
        // Initialize calendar with current date
        let currentDate = new Date();
        currentDate.setHours(0, 0, 0, 0);
        
        // Get appointment dates from the model
        const appointmentDates = [
            @foreach (var item in Model)
            {
                <text>new Date('@item.AppointmentTime.ToString("yyyy-MM-dd")'),</text>
            }
        ].map(d => {
            const date = new Date(d);
            date.setHours(0, 0, 0, 0);
            return date;
        });
        
        // Function to check if a date has an appointment
        function hasAppointment(date) {
            return appointmentDates.some(aptDate => 
                aptDate.getTime() === date.getTime()
            );
        }
        
        // Function to check if a date is today
        function isToday(date) {
            return date.getTime() === today.getTime();
        }
        
        // Generate calendar grid
        function generateCalendarGrid(date) {
            const daysGrid = document.getElementById('calendar-days-grid');
            if (!daysGrid) return;
            
            // Remove existing day cells (keep day labels)
            const dayLabels = daysGrid.querySelectorAll('.day-label');
            const existingCells = daysGrid.querySelectorAll('.day-cell');
            existingCells.forEach(cell => cell.remove());
            
            // Get first day of month and number of days
            const year = date.getFullYear();
            const month = date.getMonth();
            const firstDay = new Date(year, month, 1);
            const lastDay = new Date(year, month + 1, 0);
            const daysInMonth = lastDay.getDate();
            const startingDayOfWeek = firstDay.getDay(); // 0 = Sunday, 1 = Monday, etc.
            
            // Add empty cells for days before the first day of the month
            for (let i = 0; i < startingDayOfWeek; i++) {
                const emptyCell = document.createElement('div');
                emptyCell.className = 'day-cell empty';
                daysGrid.appendChild(emptyCell);
            }
            
            // Add cells for each day of the month
            for (let day = 1; day <= daysInMonth; day++) {
                const dayCell = document.createElement('div');
                dayCell.className = 'day-cell';
                dayCell.textContent = day;
                
                // Create date object for this day
                const cellDate = new Date(year, month, day);
                cellDate.setHours(0, 0, 0, 0);
                
                // Check if this date is today
                if (isToday(cellDate)) {
                    dayCell.classList.add('today');
                }
                
                // Check if this date has an appointment
                if (hasAppointment(cellDate)) {
                    dayCell.classList.add('has-event');
                }
                
                daysGrid.appendChild(dayCell);
            }
        }
        
        // Update calendar month display and grid
        function updateCalendarMonth(date) {
            const monthNameEl = document.getElementById('calendar-month-name');
            if (monthNameEl) {
                // Get language from HTML attribute (which should be set correctly)
                let lang = document.documentElement.lang || 'en';
                // Fallback to localStorage if HTML attribute is not set
                if (!lang || lang === 'undefined') {
                    const savedPrefs = localStorage.getItem('medicalAiPrefs');
                    if (savedPrefs) {
                        try {
                            const prefs = JSON.parse(savedPrefs);
                            lang = prefs.language === 'ar' ? 'ar' : 'en';
                        } catch (e) {
                            lang = 'en';
                        }
                    } else {
                        lang = 'en';
                    }
                }
                const formatter = new Intl.DateTimeFormat(lang, { month: 'long', year: 'numeric' });
                monthNameEl.textContent = formatter.format(date);
            }
            
            // Generate the calendar grid
            generateCalendarGrid(date);
        }
        
        // Calendar navigation
        document.querySelectorAll('.btn-nav').forEach(btn => {
            btn.addEventListener('click', function() {
                if (this.textContent.includes('<')) {
                    currentDate.setMonth(currentDate.getMonth() - 1);
                } else {
                    currentDate.setMonth(currentDate.getMonth() + 1);
                }
                updateCalendarMonth(currentDate);
            });
        });
        
        // Initialize calendar on page load
        updateCalendarMonth(currentDate);
        
        // Localize dates when language changes
        function localizeAppointmentDates(lang) {
            document.querySelectorAll('.apt-time[data-appointment-time]').forEach(el => {
                const timeStr = el.getAttribute('data-appointment-time');
                if (timeStr) {
                    const date = new Date(timeStr);
                    // Format: "February 02, 05:44 AM" (English) or Arabic equivalent
                    const formatter = new Intl.DateTimeFormat(lang, {
                        month: 'long',
                        day: '2-digit',
                        hour: '2-digit',
                        minute: '2-digit',
                        hour12: true
                    });
                    el.textContent = formatter.format(date);
                }
            });
        }
        
        // Localize appointment types
        function localizeAppointmentTypes(lang) {
            document.querySelectorAll('.apt-type[data-appointment-type]').forEach(el => {
                const type = el.getAttribute('data-appointment-type').toLowerCase();
                // Map server-side types to translation keys
                let translationKey = '';
                if (type === 'checkup') {
                    translationKey = 'appointment_checkup';
                } else if (type === 'follow-up' || type === 'followup') {
                    translationKey = 'appointment_follow_up';
                } else if (type === 'emergency') {
                    translationKey = 'appointment_emergency';
                } else if (type === 'consultation') {
                    translationKey = 'appointment_consultation';
                }
                
                const translations = window.calendarTranslations || {};
                if (translationKey && translations[lang] && translations[lang][translationKey]) {
                    el.textContent = translations[lang][translationKey];
                }
            });
        }
        
        // Listen for language changes via custom event
        document.addEventListener('languageChanged', function(event) {
            const lang = event.detail.lang || 'en';
            updateCalendarMonth(currentDate);
            localizeAppointmentDates(lang);
            localizeAppointmentTypes(lang);
        });
        
        // Also listen for lang attribute changes
        const observer = new MutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
                if (mutation.type === 'attributes' && mutation.attributeName === 'lang') {
                    const lang = document.documentElement.lang || 'en';
                    updateCalendarMonth(currentDate);
                    localizeAppointmentDates(lang);
                    localizeAppointmentTypes(lang);
                }
            });
        });
        
        observer.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ['lang']
        });
        
        // Initial localization
        const savedPrefs = localStorage.getItem('medicalAiPrefs');
        let initialLang = 'en';
        if (savedPrefs) {
            try {
                const prefs = JSON.parse(savedPrefs);
                if (prefs.language === 'ar') {
                    initialLang = 'ar';
                }
            } catch (e) {
                // Default to English on error
            }
        }
        
        // Ensure HTML attributes are set correctly
        document.documentElement.lang = initialLang;
        document.documentElement.dir = initialLang === 'ar' ? 'rtl' : 'ltr';
        
        // Initial calendar render
        updateCalendarMonth(currentDate);
        localizeAppointmentDates(initialLang);
        localizeAppointmentTypes(initialLang);
    </script>
}
