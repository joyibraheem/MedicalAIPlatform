@model MedicalAIPlatform.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_DoctorLayout";

    var hour = DateTime.Now.Hour;
    var greetingKey = hour < 12 ? "dashboard_good_morning" : hour < 17 ? "dashboard_good_afternoon" : "dashboard_good_evening";
    var greetingFallback = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
}

<link rel="stylesheet" href="~/css/medical-platform.css" asp-append-version="true" />

<div class="doc-dash-root">
    <header class="doc-dash-hero mai-reveal">
        <div class="doc-dash-hero-badge">
            <i class="bi bi-heart-pulse"></i>
            <span>Clinical workspace</span>
        </div>
        <div class="doc-dash-hero-row">
            <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(Model.UserName)&background=1D4581&color=fff&size=128"
                 class="doc-dash-avatar" alt="" width="72" height="72" />
            <div>
                <h1 class="doc-dash-title">
                    <span data-i18n="@greetingKey">@greetingFallback</span>, @Model.UserName
                </h1>
                <p class="doc-dash-lead">
                    Upload chest imaging, manage patient records, and review AI-assisted findings — all from your clinical workspace.
                </p>
            </div>
        </div>
    </header>

    <section class="doc-dash-section mai-reveal" aria-labelledby="doc-dash-quick-heading">
        <div class="doc-dash-section-head">
            <h2 id="doc-dash-quick-heading" class="doc-dash-section-title">
                <i class="bi bi-lightning-charge-fill"></i> Quick actions
            </h2>
            <p class="doc-dash-section-desc">Open the tools you use for chest X-ray and CT workflows.</p>
        </div>
        <div class="doc-dash-quick-grid doc-dash-quick-grid-3">
            <a asp-controller="Analytics" asp-action="Index" class="doc-dash-quick-card doc-dash-quick-primary">
                <div class="doc-dash-quick-icon"><i class="bi bi-cloud-upload-fill"></i></div>
                <div>
                    <strong data-i18n="dashboard_upload_new_xray">Upload &amp; analyze</strong>
                    <span data-i18n="dashboard_start_new_scan">Chest X-ray or CT inference</span>
                </div>
                <i class="bi bi-arrow-right doc-dash-quick-arrow"></i>
            </a>
            <a asp-controller="Patient" asp-action="Index" class="doc-dash-quick-card">
                <div class="doc-dash-quick-icon"><i class="bi bi-people-fill"></i></div>
                <div>
                    <strong data-i18n="nav_patients">Patients</strong>
                    <span>Records, scans &amp; medical reports</span>
                </div>
                <i class="bi bi-arrow-right doc-dash-quick-arrow"></i>
            </a>
            <a asp-controller="CtScan" asp-action="Index" class="doc-dash-quick-card">
                <div class="doc-dash-quick-icon"><i class="bi bi-box-seam-fill"></i></div>
                <div>
                    <strong>DICOM viewer</strong>
                    <span>Review DICOM, X-ray &amp; CT studies</span>
                </div>
                <i class="bi bi-arrow-right doc-dash-quick-arrow"></i>
            </a>
            <a asp-controller="AIAssistant" asp-action="Index" class="doc-dash-quick-card">
                <div class="doc-dash-quick-icon"><i class="bi bi-chat-heart-fill"></i></div>
                <div>
                    <strong data-i18n="nav_ai_assistant">AI assistant</strong>
                    <span>Clinical Q&amp;A on your cases</span>
                </div>
                <i class="bi bi-arrow-right doc-dash-quick-arrow"></i>
            </a>
            <a asp-controller="Analytics" asp-action="Combined" class="doc-dash-quick-card">
                <div class="doc-dash-quick-icon"><i class="bi bi-bezier2"></i></div>
                <div>
                    <strong>Combined analysis</strong>
                    <span>Multi-modal X-ray &amp; text results</span>
                </div>
                <i class="bi bi-arrow-right doc-dash-quick-arrow"></i>
            </a>
            <a asp-controller="Settings" asp-action="Index" class="doc-dash-quick-card">
                <div class="doc-dash-quick-icon doc-dash-quick-icon-muted"><i class="bi bi-gear-wide-connected"></i></div>
                <div>
                    <strong>Settings</strong>
                    <span>Profile, preferences &amp; help</span>
                </div>
                <i class="bi bi-arrow-right doc-dash-quick-arrow"></i>
            </a>
        </div>
    </section>

    <section class="doc-dash-section mai-reveal" aria-labelledby="doc-dash-workflow-heading">
        <div class="doc-dash-section-head">
            <h2 id="doc-dash-workflow-heading" class="doc-dash-section-title">
                <i class="bi bi-diagram-3-fill"></i> Clinical workflow
            </h2>
            <p class="doc-dash-section-desc">A typical path through the platform — each step links to an existing module.</p>
        </div>
        <div class="doc-dash-workflow">
            <a asp-controller="Patient" asp-action="Create" class="doc-dash-workflow-step">
                <span class="doc-dash-workflow-num">1</span>
                <div>
                    <strong>Register patient</strong>
                    <span>Add a patient and attach imaging</span>
                </div>
                <i class="bi bi-person-plus"></i>
            </a>
            <a asp-controller="Analytics" asp-action="Index" class="doc-dash-workflow-step">
                <span class="doc-dash-workflow-num">2</span>
                <div>
                    <strong>Run AI analysis</strong>
                    <span>Upload X-ray or CT for inference</span>
                </div>
                <i class="bi bi-cpu"></i>
            </a>
            <a asp-controller="Patient" asp-action="Index" class="doc-dash-workflow-step">
                <span class="doc-dash-workflow-num">3</span>
                <div>
                    <strong>Review &amp; report</strong>
                    <span>Open patient chart and generate reports</span>
                </div>
                <i class="bi bi-file-earmark-medical"></i>
            </a>
        </div>
    </section>

    <section class="doc-dash-cta mai-reveal">
        <div class="doc-dash-cta-content">
            <div class="doc-dash-cta-icon" aria-hidden="true"><i class="bi bi-lungs-fill"></i></div>
            <div>
                <h2 data-i18n="dashboard_upload_new_xray">Start a new AI chest analysis</h2>
                <p data-i18n="dashboard_start_new_scan">Upload DICOM or image files for X-ray and CT inference with explainable heatmaps.</p>
            </div>
        </div>
        <a asp-controller="Analytics" asp-action="Index" class="doc-dash-cta-btn" data-i18n="dashboard_upload_now">
            Upload now <i class="bi bi-arrow-right"></i>
        </a>
    </section>
</div>

@section Scripts {
    <script>
        document.body.classList.add('doctor-dash-page');
    </script>
}
