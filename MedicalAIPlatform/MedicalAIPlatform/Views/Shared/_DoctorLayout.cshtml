@using System.Security.Claims
@{
    var maiClinicalUserId = User.Identity?.IsAuthenticated == true
        ? (User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty)
        : string.Empty;

    var isAdmin = User.IsInRole("Admin");
    var isDoctor = User.IsInRole("Doctor") || (User.Identity?.IsAuthenticated == true && !isAdmin);

    var isDarkMode = true;
    if (Context.Request.Cookies.TryGetValue("Settings_DarkMode", out var darkModeVal))
    {
        if (bool.TryParse(darkModeVal, out var parsedMode))
        {
            isDarkMode = parsedMode;
        }
    }

    var language = "en";
    var dir = "ltr";
    var bodyClass = "doctor-dashboard";
    if (isAdmin) { bodyClass += " role-admin"; }
    else if (isDoctor) { bodyClass += " role-doctor"; }
    if (!isDarkMode)
    {
        bodyClass += " light-mode";
    }
}
<!DOCTYPE html>
<html lang="@language" dir="@dir" class="@(!isDarkMode ? "light-mode-global" : "")">
<head>
    <script>
        (function () {
            // Initialize theme immediately to prevent flash
            const savedTheme = localStorage.getItem("theme");
            const prefs = localStorage.getItem("medicalAiPrefs") ? JSON.parse(localStorage.getItem("medicalAiPrefs")) : null;
            
            let isDarkMode = true; // Default to dark
            if (savedTheme === "light" || savedTheme === "dark") {
                isDarkMode = savedTheme === "dark";
            } else if (prefs && typeof prefs.isDarkMode === "boolean") {
                isDarkMode = prefs.isDarkMode;
            }
            
            // Apply theme immediately
            document.documentElement.setAttribute("data-theme", isDarkMode ? "dark" : "light");
            document.documentElement.classList.toggle("light-mode-global", !isDarkMode);
            
            // Apply body classes
            if (document.body) {
                document.body.classList.toggle("light-mode", !isDarkMode);
                document.body.classList.toggle("dark-mode", isDarkMode);
            } else {
                document.addEventListener("DOMContentLoaded", function() {
                    document.body.classList.toggle("light-mode", !isDarkMode);
                    document.body.classList.toggle("dark-mode", isDarkMode);
                });
            }
            
            // Initialize language
            const savedLang = localStorage.getItem("lang") || (prefs ? prefs.language : null) || "en";
            document.documentElement.setAttribute("lang", savedLang);
            document.documentElement.setAttribute("dir", savedLang === "ar" ? "rtl" : "ltr");
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MedicalAIPlatform</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    
    <!-- Admin CSS for App Frame & Header Consistency -->
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    
    <!-- Custom Styles -->
    <link rel="stylesheet" href="~/css/doctor-dashboard.css" asp-append-version="true" />
    <!-- Site CSS for global overrides -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/medical-platform.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/role-themes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/medical-ai-assistant-chat.css" asp-append-version="true" />
    <style>
        #darkOverlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.3);
            z-index: 0;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.25s ease;
        }

        html[data-theme="dark"] #darkOverlay {
            opacity: 0.5;
        }
        
        html[data-theme="dark"] .app-frame,
        body.dark-mode .app-frame {
            position: relative;
            z-index: 1;
        }
        
        html[data-theme="dark"] .app-content,
        body.dark-mode .app-content {
            position: relative;
            z-index: 2;
        }
    </style>
</head>
<body class="@bodyClass">
    <script src="~/js/toast.js" asp-append-version="true"></script>
    <div id="darkOverlay"></div>
    
    <!-- The Central App Frame -->
    <div class="app-frame">
        
        <!-- Header — desktop only (≥992px) -->
        <header class="app-header app-header-desktop" aria-label="Desktop navigation">
            <div class="header-left">
                <div class="logo-container">
                    <img src="~/images/chest-icon.png" alt="ChestAI" class="logo-icon" style="width: 36px; height: 36px; border-radius: 6px;" />
                    <span class="brand-name" data-i18n="brand_chestai">ChestAI</span>
                </div>
                <nav class="main-nav">
                    <a asp-controller="Home" asp-action="Index" class="nav-link" data-i18n="nav_home">Home</a>
                    <a asp-controller="Patient" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Patient" ? "active" : "")" data-i18n="nav_patients">Patients</a>
                    <a asp-controller="Analytics" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Analytics" ? "active" : "")" data-i18n="nav_analytics">Analytics</a>
                    <a asp-controller="CtScan" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CtScan" ? "active" : "")">CT Scan</a>
                    <a asp-controller="AIAssistant" asp-action="Index" class="nav-link @(ViewData["Title"]?.ToString() == "AI Assistant" ? "active" : "")" data-i18n="nav_ai_assistant">AI Assistant</a>
                    @if (isAdmin)
                    {
                        <a asp-controller="Admin" asp-action="Index" class="nav-link nav-link-admin @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")"><i class="bi bi-shield-lock"></i> Admin</a>
                    }
                </nav>
            </div>
            
            <div class="header-right">
                <a asp-controller="Account" asp-action="Logout" class="nav-link" style="text-decoration:none; color:inherit;">
                    <div style="cursor:pointer; font-weight:500; font-size:1rem; color: #6B7280; display:flex; align-items:center; gap:8px;">
                         <span data-i18n="nav_logout">Logout</span>
                         <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                           <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                         </svg>
                    </div>
                </a>
            </div>
        </header>

        <!-- Header — mobile/tablet only (<992px); no app-header class to avoid desktop CSS -->
        <header class="app-header-mobile" aria-label="Mobile navigation">
            <nav class="navbar navbar-light w-100 px-0 py-0" aria-label="Main navigation">
                <div class="w-100 d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <a class="navbar-brand logo-container mb-0" asp-controller="Home" asp-action="Index">
                        <img src="~/images/chest-icon.png" alt="ChestAI" class="logo-icon" width="36" height="36" style="border-radius: 6px;" />
                        <span class="brand-name" data-i18n="brand_chestai">ChestAI</span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#chestAiMainNav"
                            aria-controls="chestAiMainNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse w-100" id="chestAiMainNav">
                        <ul class="navbar-nav main-nav">
                            <li class="nav-item">
                                <a asp-controller="Home" asp-action="Index" class="nav-link" data-i18n="nav_home">Home</a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Patient" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Patient" ? "active" : "")" data-i18n="nav_patients">Patients</a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Analytics" asp-action="Index" class="nav-link @(ViewData["Title"]?.ToString() == "Analytics" ? "active" : "")" data-i18n="nav_analytics">Analytics</a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="CtScan" asp-action="Index" class="nav-link @(ViewData["Title"]?.ToString() == "CT Scan" ? "active" : "")">CT Scan</a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="AIAssistant" asp-action="Index" class="nav-link @(ViewData["Title"]?.ToString() == "AI Assistant" ? "active" : "")" data-i18n="nav_ai_assistant">AI Assistant</a>
                            </li>
                        </ul>
                        <ul class="navbar-nav header-right">
                            <li class="nav-item">
                                <a asp-controller="Account" asp-action="Logout" class="nav-link d-flex align-items-center gap-2">
                                    <span data-i18n="nav_logout">Logout</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                                    </svg>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <div class="app-content">
            @RenderBody()
        </div>

    </div>

    <!-- Floating Settings Button -->
    <a asp-controller="Settings" asp-action="Index" class="settings-fab">
        <i class="bi bi-gear-wide-connected"></i>
    </a>

    <script>
        window.__maiClinicalUserId = @System.Text.Json.JsonSerializer.Serialize(maiClinicalUserId);
        window.__maiSendMessageUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("SendMessage", "AIAssistant") ?? "/AIAssistant/SendMessage"));
        window.__maiAssistantEnqueueUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Content("~/api/assistant/chat/enqueue")));
        window.__maiChatMessagesUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Content("~/api/assistant/chat/messages")));
        window.__maiAssistantHubUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Content("~/hubs/assistant")));
        window.__maiJobStatusUrlPrefix = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Content("~/api/job/status/")));
        window.__maiChestIconUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Content("~/images/chest-icon.png")));
        window.__maiFeedbackSubmitUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Content("~/api/feedback/submit")));
    </script>
    <partial name="_MedicalAiAssistantChat" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8.0.7/dist/browser/signalr.min.js" crossorigin="anonymous"></script>
    <script src="~/js/chestai-signalr.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/clinical-feedback.js" asp-append-version="true"></script>
    <script src="~/js/i18n.js" asp-append-version="true"></script>
    <script src="~/js/i18n.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/premium-interactions.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
