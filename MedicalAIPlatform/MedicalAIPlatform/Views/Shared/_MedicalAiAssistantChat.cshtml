@* Premium messenger-style assistant: floating FAB + CT/async updates *@
<div id="medical-ai-chat-root" class="mai-chat-root" aria-live="polite">
    <button type="button"
            id="mai-chat-launcher"
            class="mai-chat-launcher"
            aria-expanded="false"
            aria-controls="mai-chat-panel"
            aria-label="ChestAI Assistant — open messages and scan updates">
        <span class="mai-chat-launcher-shine" aria-hidden="true"></span>
        <span class="mai-chat-launcher-ring" aria-hidden="true"></span>
        <span class="mai-chat-launcher-orbit" aria-hidden="true"></span>
        <span class="mai-chat-launcher-glow" aria-hidden="true"></span>
        <span class="mai-chat-launcher-ripple" aria-hidden="true"></span>
        <span class="mai-chat-launcher-icon" aria-hidden="true">
            <svg class="mai-chat-launcher-svg" width="28" height="28" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <!-- Layered bubbles + insight dot (reads well at small sizes) -->
                <path class="mai-chat-launcher-bubble-back"
                      opacity="0.4"
                      d="M21.25 5.25H10a3.75 3.75 0 0 0-3.75 3.75v8.6a3.75 3.75 0 0 0 3.75 3.75h3.1l3.15 2.55v-2.55h4.9a3.75 3.75 0 0 0 3.75-3.75V9a3.75 3.75 0 0 0-3.75-3.75Z"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.35"
                      stroke-linejoin="round" />
                <path class="mai-chat-launcher-bubble-front"
                      d="M25.25 9.75H13.5a3.75 3.75 0 0 0-3.75 3.75v7.35a3.75 3.75 0 0 0 3.75 3.75h-1.65L9 26.85V24.6h16.25a3.75 3.75 0 0 0 3.75-3.75v-7.35a3.75 3.75 0 0 0-3.75-3.75Z"
                      fill="currentColor"
                      fill-opacity="0.11"
                      stroke="currentColor"
                      stroke-width="1.45"
                      stroke-linejoin="round" />
                <circle class="mai-chat-launcher-insight" cx="23.85" cy="8.35" r="2.2" fill="#fde047" />
                <path d="M11.75 17.25h11.5M11.75 20.6h7.8"
                      stroke="currentColor"
                      stroke-width="1.25"
                      stroke-linecap="round"
                      opacity="0.5" />
            </svg>
        </span>
        <span id="mai-chat-badge" class="mai-chat-badge" hidden></span>
        <span class="mai-chat-launcher-tip">ChestAI · Messages &amp; scan updates</span>
    </button>

    <section id="mai-chat-panel"
             class="mai-chat-panel"
             role="dialog"
             aria-labelledby="mai-chat-heading"
             aria-modal="false"
             hidden>
        <header class="mai-chat-header">
            <div class="mai-chat-header-brand">
                <div class="mai-chat-header-avatar" aria-hidden="true">
                    <img src="@Url.Content("~/images/chest-icon.png")" alt="" width="44" height="44" loading="lazy" />
                </div>
                <div class="mai-chat-header-text">
                    <div class="mai-chat-title-row">
                        <h2 id="mai-chat-heading" class="mai-chat-title">ChestAI Assistant</h2>
                        <span class="mai-chat-live-pill" title="Realtime sync active"><span class="mai-chat-live-dot"></span> Live</span>
                    </div>
                    <p class="mai-chat-subtitle">Scan pipeline · summaries · alerts</p>
                </div>
            </div>
            <div class="mai-chat-header-actions">
                <button type="button" id="mai-chat-width-toggle" class="mai-chat-icon-btn" aria-pressed="false" aria-label="Toggle wider chat" title="Toggle width">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                </button>
                <button type="button" id="mai-chat-minimize" class="mai-chat-icon-btn" aria-label="Minimize chat" title="Minimize">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 12h12"/></svg>
                </button>
                <button type="button" id="mai-chat-close" class="mai-chat-icon-btn mai-chat-icon-btn--close" aria-label="Close chat">&times;</button>
            </div>
        </header>

        <div class="mai-chat-body">
            <div class="mai-chat-scroll-area" id="mai-chat-scroll-area">
                <div id="mai-chat-skeleton" class="mai-chat-skeleton">
                    <div class="mai-chat-skeleton-line mai-chat-skeleton-line--short"></div>
                    <div class="mai-chat-skeleton-line"></div>
                    <div class="mai-chat-skeleton-line mai-chat-skeleton-line--medium"></div>
                    <div class="mai-chat-skeleton-line mai-chat-skeleton-line--tiny"></div>
                    <div class="mai-chat-skeleton-line"></div>
                </div>

                <div id="mai-chat-onboarding" class="mai-chat-onboarding" hidden>
                    <div class="mai-chat-onboarding-visual" aria-hidden="true">
                        <div class="mai-chat-onboarding-glow"></div>
                        <svg class="mai-chat-onboarding-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M12 3v4M12 17v4M4 12h4M16 12h4M6.34 6.34l2.83 2.83M14.83 14.83l2.83 2.83M17.66 6.34l-2.83 2.83M9.17 14.83l-2.83 2.83" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
                            <circle cx="12" cy="12" r="3.25" stroke="currentColor" stroke-width="1.35"/>
                        </svg>
                    </div>
                    <p class="mai-chat-onboarding-kicker">Clinical workspace</p>
                    <h3 class="mai-chat-onboarding-title">Stay on top of every scan</h3>
                    <p class="mai-chat-onboarding-copy">Upload imaging from Analytics — CT progress, queued jobs, and AI summaries land here automatically.</p>

                    <div class="mai-chat-quick-actions" role="toolbar" aria-label="Quick actions">
                        <button type="button" class="mai-chip mai-chip--accent" data-mai-nav="@Url.Content("~/Analytics")">Analyze X-ray</button>
                        <button type="button" class="mai-chip" data-mai-nav="@Url.Content("~/Analytics")">Chest CT upload</button>
                        <button type="button" class="mai-chip" data-mai-nav="@Url.Content("~/Analytics/Combined")">Combined results</button>
                    </div>

                    <p class="mai-chat-suggest-label">Suggested next steps</p>
                    <div class="mai-chat-suggestions">
                        <button type="button" class="mai-suggestion" data-mai-nav="@Url.Content("~/AIAssistant")"><span class="mai-suggestion-arrow">→</span> Explain my latest CT summary</button>
                        <button type="button" class="mai-suggestion" data-mai-nav="@Url.Content("~/Analytics")"><span class="mai-suggestion-arrow">→</span> Upload and analyze a scan</button>
                        <button type="button" class="mai-suggestion" data-mai-nav="@Url.Content("~/Patient")"><span class="mai-suggestion-arrow">→</span> Open patient records</button>
                    </div>
                </div>

                <div id="mai-chat-messages" class="mai-chat-messages"></div>
            </div>

            <div id="mai-chat-typing" class="mai-chat-typing-anchor" hidden>
                <div class="mai-chat-typing-bubble" aria-live="polite">
                    <span class="mai-chat-typing-dots" aria-hidden="true"><span></span><span></span><span></span></span>
                    <span id="mai-chat-typing-label" class="mai-chat-typing-label">ChestAI is analyzing…</span>
                </div>
            </div>
        </div>

        <footer class="mai-chat-footer">
            <label class="mai-chat-sound-row">
                <input type="checkbox" id="mai-chat-sound-on" />
                <span class="mai-chat-sound-label">Subtle sound when a reply finishes</span>
            </label>
            <p class="mai-chat-disclaimer">Assistive AI only — not a diagnosis. Verify all findings clinically.</p>
        </footer>
    </section>
</div>

<script src="~/js/medical-ai-assistant-storage.js" asp-append-version="true"></script>
<script src="~/js/medical-ai-assistant-jobs.js" asp-append-version="true"></script>
<script src="~/js/medical-ai-assistant-chat.js" asp-append-version="true"></script>
