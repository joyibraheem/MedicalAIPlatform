@using MedicalAIPlatform.Models
@{
    var selectedModelId = ViewBag.SelectedXRayModelId as string ?? ChestXRayModels.CheXNet;
    var inputName = ViewBag.XRayModelInputName as string ?? "xrayModel";
    var groupName = ViewBag.XRayModelGroupName as string ?? "xrayModelChoice";
}

<div class="chest-xray-model-selector mb-3">
    <label class="input-label fw-semibold mb-2">Choose AI Model</label>
    @foreach (var option in ChestXRayModels.Options)
    {
        var isChecked = string.Equals(selectedModelId, option.Id, StringComparison.OrdinalIgnoreCase)
            || (string.Equals(option.Id, ChestXRayModels.CheXNet, StringComparison.Ordinal)
                && !ChestXRayModels.IsSupported(selectedModelId));
        <div class="form-check mb-2">
            <input class="form-check-input"
                   type="radio"
                   name="@groupName"
                   id="xrayModel_@option.Id"
                   value="@option.Id"
                   @(isChecked ? "checked" : null)
                   onchange="document.getElementById('@inputName')?.setAttribute('value', this.value);" />
            <label class="form-check-label" for="xrayModel_@option.Id">
                <strong>@option.Label</strong>
                <small class="text-muted d-block">@option.Status</small>
            </label>
        </div>
    }
    <input type="hidden" id="@inputName" name="@inputName" value="@ChestXRayModels.Normalize(selectedModelId)" />
</div>
