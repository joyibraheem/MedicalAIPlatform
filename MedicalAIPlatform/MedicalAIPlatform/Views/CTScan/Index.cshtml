@{
    ViewData["Title"] = "CT Scan";
    Layout = "_DoctorLayout";
}

<link rel="stylesheet" href="~/css/ctscan.css" asp-append-version="true" />

<div class="ctscan-page">
    <div class="ctscan-header">
        <div>
            <h1 data-i18n="ctscan_title">CT Scan Viewer</h1>
            <p data-i18n="ctscan_subtitle">Medical image viewer with AI-assisted analysis</p>
        </div>
        <div class="patient-info">
            <div class="patient-name" style="font-size:0.9rem;color:#6B7280;">@(ViewBag.DoctorName ?? "Doctor")</div>
        </div>
    </div>

    <div class="ctscan-card">
        <div class="ctscan-toolbar">
            <button type="button" class="toolbar-btn active" id="btnSeries" title="Toggle series sidebar">
                <i class="bi bi-layout-sidebar"></i><span class="btn-text">Series</span>
            </button>
            <button type="button" class="toolbar-btn" id="btnPrevious" title="Previous slice">
                <i class="bi bi-chevron-left"></i><span class="btn-text">Previous</span>
            </button>
            <button type="button" class="toolbar-btn" id="btnNext" title="Next slice">
                <i class="bi bi-chevron-right"></i><span class="btn-text">Next</span>
            </button>
            <button type="button" class="toolbar-btn" id="btnPlay" title="Play slideshow">
                <i class="bi bi-play-fill"></i><span class="btn-text">Play</span>
            </button>
            <button type="button" class="toolbar-btn" id="btnZoom" title="Toggle zoom">
                <i class="bi bi-zoom-in"></i><span class="btn-text">Zoom</span>
            </button>
            <button type="button" class="toolbar-btn" id="btnDelete" title="Delete selected scan">
                <i class="bi bi-trash"></i><span class="btn-text">Delete</span>
            </button>
            <button type="button" class="toolbar-btn" id="btnPan" title="Pan mode">
                <i class="bi bi-arrows-move"></i><span class="btn-text">Pan</span>
            </button>
            <button type="button" class="toolbar-btn" id="btnRectangle" title="Draw rectangle">
                <i class="bi bi-bounding-box"></i><span class="btn-text">Rectangle</span>
            </button>
            <button type="button" class="toolbar-btn" id="btnAnnotate" title="Add annotation">
                <i class="bi bi-chat-left-text"></i><span class="btn-text">Annotate</span>
            </button>
            <div class="ctscan-dropdown">
                <button type="button" class="toolbar-btn" id="btnMore" title="More actions">
                    <i class="bi bi-three-dots"></i><span class="btn-text">More</span>
                </button>
                <div class="ctscan-dropdown-menu" id="moreDropdown">
                    <button type="button" id="menuUpload"><i class="bi bi-cloud-upload"></i> Upload new scan</button>
                    <button type="button" id="menuDownload"><i class="bi bi-download"></i> Download report</button>
                    <button type="button" id="menuReset"><i class="bi bi-arrow-counterclockwise"></i> Reset viewer</button>
                </div>
            </div>
            <div class="toolbar-spacer"></div>
            <button type="button" class="toolbar-btn analyze-btn" id="btnAnalyze">
                <i class="bi bi-cpu"></i><span class="btn-text">Analyze Scan</span>
            </button>
        </div>

        <div class="ctscan-body">
            <aside class="ctscan-sidebar" id="ctSidebar">
                <div id="thumbnailList"></div>
            </aside>

            <div class="ctscan-viewer-wrap">
                <div class="ctscan-viewer-grid" id="viewerGrid">
                    <div class="ctscan-panel primary" data-panel="0">
                        <span class="panel-label">Panel 1</span>
                        <img src="" alt="CT Scan" draggable="false" />
                        <canvas class="ctscan-annotation-layer"></canvas>
                    </div>
                    <div class="ctscan-panel" data-panel="1">
                        <span class="panel-label">Panel 2</span>
                        <img src="" alt="CT Scan" draggable="false" />
                        <canvas class="ctscan-annotation-layer"></canvas>
                    </div>
                    <div class="ctscan-panel" data-panel="2">
                        <span class="panel-label">Panel 3</span>
                        <img src="" alt="CT Scan" draggable="false" />
                        <canvas class="ctscan-annotation-layer"></canvas>
                    </div>
                    <div class="ctscan-panel" data-panel="3">
                        <span class="panel-label">Panel 4</span>
                        <img src="" alt="CT Scan" draggable="false" />
                        <canvas class="ctscan-annotation-layer"></canvas>
                    </div>
                </div>
            </div>

            <aside class="ctscan-results" id="aiResults">
                <h3><i class="bi bi-robot"></i> AI Analysis</h3>
                <div id="resultsContent">
                    <p class="placeholder-text">Select a scan and click "Analyze Scan" to run AI analysis.</p>
                </div>
            </aside>
        </div>
    </div>
</div>

<div class="ctscan-upload-overlay" id="uploadOverlay">
    <div class="ctscan-upload-modal">
        <h4><i class="bi bi-cloud-upload"></i> Upload CT / X-Ray Scan</h4>
        <label class="ctscan-upload-zone" id="uploadZone" for="uploadFileInput">
            <i class="bi bi-file-earmark-medical"></i>
            <p id="uploadFileName">Drop file here or click to browse</p>
            <small style="color:#9CA3AF;">JPG, JPEG, PNG, DCM supported</small>
            <input type="file" id="uploadFileInput" accept=".jpg,.jpeg,.png,.dcm,.dicm,image/jpeg,image/png,application/dicom" class="d-none" />
        </label>
        <div class="mb-2 mt-2">
            <input type="text" class="form-control form-control-sm" id="uploadPatientName" placeholder="Patient name (optional)" />
        </div>
        <div class="ctscan-upload-actions">
            <button type="button" class="btn btn-sm btn-outline-secondary" id="uploadCancel">Cancel</button>
            <button type="button" class="btn btn-sm btn-primary" id="uploadSubmit" disabled>Upload</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.ctScanConfig = {
            getScansUrl: '@Url.Action("GetScans", "CTScan")',
            uploadUrl: '@Url.Action("Upload", "CTScan")',
            deleteUrl: '@Url.Action("Delete", "CTScan")',
            placeholders: [
                '@Url.Content("~/images/ct-placeholders/ct-1.svg")',
                '@Url.Content("~/images/ct-placeholders/ct-2.svg")',
                '@Url.Content("~/images/ct-placeholders/ct-3.svg")',
                '@Url.Content("~/images/ct-placeholders/ct-4.svg")',
                '@Url.Content("~/images/ct-placeholders/ct-5.svg")'
            ]
        };
    </script>
    <script src="~/js/ctscan.js" asp-append-version="true"></script>
}
