@model MedicalAIPlatform.Models.FineTuningDashboardViewModel
@{
    ViewData["Title"] = "AI Model Management & Fine-Tuning Center";
    Layout = "_DoctorLayout";
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/admin-finetuning-center.css" asp-append-version="true" />

@Html.AntiForgeryToken()

<div class="ftc-root admin-dash-root" id="ftc-root" data-refresh="@Model.LiveRefreshSeconds">
    <header class="admin-dash-header ftc-header">
        <div>
            <p class="admin-dash-kicker">Admin · Model Operations</p>
            <h1 class="admin-dash-title">AI Model Management &amp; Fine-Tuning Center</h1>
            <p class="admin-dash-lead">
                Manage CheXNet, Lung Cancer, and BioBERT training pipelines. BRAX dataset fine-tuning runs locally;
                HITL models retrain from doctor feedback. Production deployment is manual only.
            </p>
        </div>
        <div class="admin-dash-header-meta">
            <span class="admin-pill" id="ftc-system-pill"><i class="bi bi-hdd-network"></i> System OK</span>
            <a asp-controller="Admin" asp-action="Index" class="btn btn-sm admin-btn-outline">← Admin dashboard</a>
        </div>
    </header>

    @if (TempData["AdminError"] is string err)
    {
        <div class="alert alert-danger">@err</div>
    }
    @if (TempData["AdminSuccess"] is string okMsg)
    {
        <div class="alert alert-success">@okMsg</div>
    }

    <section class="ftc-section ftc-home-summary" id="ftc-section-home">
        <div class="ftc-section-body">
            <div class="row g-2" id="ftc-home-cards"></div>
        </div>
    </section>

    <section class="ftc-section" id="ftc-section-workflow-global">
        <button class="ftc-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#ftc-collapse-workflow-global" aria-expanded="true">
            <span><i class="bi bi-diagram-2"></i> Workflow Timeline</span>
            <i class="bi bi-chevron-down"></i>
        </button>
        <div class="collapse show" id="ftc-collapse-workflow-global">
            <div class="ftc-section-body"><div class="ftc-workflow-rail" id="ftc-workflow-rail"></div></div>
        </div>
    </section>

    <ul class="nav nav-pills ftc-main-tabs mb-4" id="ftc-main-tabs" role="tablist">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#ftc-tab-models" type="button">Models</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#ftc-tab-datasets" type="button">Datasets</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#ftc-tab-training" type="button">Training</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#ftc-tab-experiments" type="button">Experiments</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#ftc-tab-deployment" type="button">Deployment</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#ftc-tab-history" type="button">History</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#ftc-tab-system" type="button">System Monitor</button></li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#ftc-tab-notifications" type="button">
                Notifications <span class="ftc-tab-badge" id="ftc-notif-badge">0</span>
            </button>
        </li>
    </ul>

    <div class="tab-content ftc-tab-content">
        <div class="tab-pane fade show active" id="ftc-tab-models">
    <section class="ftc-section" id="ftc-section-models">
        <button class="ftc-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#ftc-collapse-models" aria-expanded="true">
            <span><i class="bi bi-grid-3x3-gap"></i> Model Selection</span>
            <i class="bi bi-chevron-down"></i>
        </button>
        <div class="collapse show" id="ftc-collapse-models">
            <div class="ftc-section-body">
                <div class="row g-3" id="ftc-model-cards"></div>
            </div>
        </div>
    </section>
            <section class="ftc-section" id="ftc-section-future">
                <button class="ftc-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#ftc-collapse-future">
                    <span><i class="bi bi-plug"></i> Extensible Pipeline Architecture</span>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <div class="collapse" id="ftc-collapse-future">
                    <div class="ftc-section-body">
                        <p class="mb-2">Each AI model registers an <code>IModelTrainingPipeline</code> plugin. Add Model 4+ in DI without UI changes.</p>
                        <div id="ftc-plugin-registry" class="row g-2"></div>
                    </div>
                </div>
            </section>
            <section class="ftc-section" id="ftc-section-architecture">
                <button class="ftc-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#ftc-collapse-architecture">
                    <span><i class="bi bi-diagram-3-fill"></i> Architecture Viewer</span>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <div class="collapse" id="ftc-collapse-architecture">
                    <div class="ftc-section-body" id="ftc-architecture-panel">
                        <p class="text-muted small mb-0">Select a model to view architecture details.</p>
                    </div>
                </div>
            </section>
        </div>

        <div class="tab-pane fade" id="ftc-tab-datasets">
    <section class="ftc-section" id="ftc-section-dataset">
        <button class="ftc-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#ftc-collapse-dataset" aria-expanded="true">
            <span><i class="bi bi-database"></i> Dataset Management</span>
            <i class="bi bi-chevron-down"></i>
        </button>
        <div class="collapse show" id="ftc-collapse-dataset">
            <div class="ftc-section-body">
                <div class="row g-4">
                    <div class="col-lg-5">
                        <div class="ftc-panel">
                            <h3 class="ftc-panel-title">Prepare dataset</h3>
                            <div class="mb-3">
                                <label class="form-label">Upload ZIP</label>
                                <input type="file" class="form-control form-control-sm" id="ftc-dataset-zip" accept=".zip" />
                                <button type="button" class="btn btn-sm btn-outline-primary mt-2" id="ftc-upload-btn">Upload &amp; extract</button>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Or choose stored dataset</label>
                                <select class="form-select form-select-sm" id="ftc-dataset-select"></select>
                            </div>
                            <button type="button" class="btn btn-primary btn-sm" id="ftc-validate-btn">
                                <i class="bi bi-check2-circle"></i> Validate Dataset
                            </button>
                        </div>
                    </div>
                    <div class="col-lg-7">
                        <div class="ftc-panel" id="ftc-dataset-report">
                            <h3 class="ftc-panel-title">Dataset report</h3>
                            <p class="text-muted small mb-0">Run validation to inspect dataset health before training.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
            <section class="ftc-section" id="ftc-section-archive">
                <button class="ftc-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#ftc-collapse-archive" aria-expanded="true">
                    <span><i class="bi bi-archive"></i> Dataset Archive</span>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <div class="collapse show" id="ftc-collapse-archive">
                    <div class="ftc-section-body">
                        <div class="table-responsive">
                            <table class="table table-sm ftc-table" id="ftc-archive-table">
                                <thead><tr><th>Name</th><th>Uploaded</th><th>Size</th><th>Images</th><th>Patients</th><th>Runs</th><th>Actions</th></tr></thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </section>
            <section class="ftc-section" id="ftc-section-dataset-preview">
                <button class="ftc-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#ftc-collapse-dataset-preview" aria-expanded="true">
                    <span><i class="bi bi-eye"></i> Dataset Preview &amp; Statistics</span>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <div class="collapse show" id="ftc-collapse-dataset-preview">
                    <div class="ftc-section-body">
                        <div class="d-flex gap-2 mb-3 flex-wrap">
                            <button type="button" class="btn btn-sm btn-outline-primary" id="ftc-preview-load">Load preview</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="ftc-stats-load">Generate statistics</button>
                        </div>
                        <div class="row g-3">
                            <div class="col-lg-5"><div id="ftc-dataset-preview-panel" class="ftc-panel"></div></div>
                            <div class="col-lg-7">
                                <div id="ftc-dataset-stats-cards" class="row g-2 mb-3"></div>
                                <div class="row g-2">
                                    <div class="col-md-6"><div class="ftc-chart-wrap"><canvas id="chart-disease-dist"></canvas></div></div>
                                    <div class="col-md-6"><div class="ftc-chart-wrap"><canvas id="chart-normal-positive"></canvas></div></div>
                                    <div class="col-md-6"><div class="ftc-chart-wrap"><canvas id="chart-label-freq"></canvas></div></div>
                                    <div class="col-md-6"><div class="ftc-chart-wrap"><canvas id="chart-train-val"></canvas></div></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <section class="ftc-section" id="ftc-section-dataset-explorer">
                <button class="ftc-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#ftc-collapse-dataset-explorer">
                    <span><i class="bi bi-search"></i> Dataset Explorer</span>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <div class="collapse" id="ftc-collapse-dataset-explorer">
                    <div class="ftc-section-body">
                        <div class="row g-2 mb-2">
                            <div class="col-md-2"><input class="form-control form-control-sm" id="ftc-exp-patient" placeholder="Patient ID" /></div>
                            <div class="col-md-2"><input class="form-control form-control-sm" id="ftc-exp-study" placeholder="Study" /></div>
                            <div class="col-md-2"><input class="form-control form-control-sm" id="ftc-exp-disease" placeholder="Disease" /></div>
                            <div class="col-md-2"><input class="form-control form-control-sm" id="ftc-exp-image" placeholder="Image" /></div>
                            <div class="col-md-2"><input class="form-control form-control-sm" id="ftc-exp-label" placeholder="Label" /></div>
                            <div class="col-md-2"><button type="button" class="btn btn-sm btn-primary w-100" id="ftc-exp-search">Search</button></div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm ftc-table" id="ftc-explorer-table">
                                <thead><tr><th>Patient</th><th>Study</th><th>Image</th><th>Labels</th><th>View</th><th>DICOM</th><th>PNG</th></tr></thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </section>
            <section class="ftc-section" id="ftc-section-dataset-versions">
                <button class="ftc-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#ftc-collapse-dataset-versions">
                    <span><i class="bi bi-tags"></i> Dataset Versioning</span>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <div class="collapse" id="ftc-collapse-dataset-versions">
                    <div class="ftc-section-body">
                        <div class="table-responsive">
                            <table class="table table-sm ftc-table" id="ftc-dataset-versions-table">
                                <thead><tr><th>Version</th><th>Hash</th><th>Created</th><th>Validation</th><th>Path</th></tr></thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="tab-pane fade" id="ftc-tab-training">
            <section class="ftc-section" id="ftc-section-wizard">
                <button class="ftc-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#ftc-collapse-wizard" aria-expanded="true">
                    <span><i class="bi bi-signpost-split"></i> Training Wizard (Optional)</span>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <div class="collapse show" id="ftc-collapse-wizard">
                    <div class="ftc-section-body">
                        <div class="ftc-wizard-steps" id="ftc-wizard-steps"></div>
                        <p class="text-muted small mt-2 mb-0">Follow the guided workflow or use the sections below directly.</p>
                    </div>
                </div>
            </section>
            <section class="ftc-section" id="ftc-section-presets">
                <button class="ftc-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#ftc-collapse-presets" aria-expanded="true">
                    <span><i class="bi bi-lightning"></i> Hyperparameter Presets</span>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <div class="collapse show" id="ftc-collapse-presets">
                    <div class="ftc-section-body"><div class="row g-2" id="ftc-preset-cards"></div></div>
                </div>
            </section>
    <section class="ftc-section" id="ftc-section-config">
        <button class="ftc-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#ftc-collapse-config" aria-expanded="true">
            <span><i class="bi bi-sliders"></i> Fine-Tuning Configuration</span>
            <i class="bi bi-chevron-down"></i>
        </button>
        <div class="collapse show" id="ftc-collapse-config">
            <div class="ftc-section-body">
                <form id="ftc-config-form" class="row g-3">
                    <div class="col-md-3 col-sm-6">
                        <label class="form-label">Subset size</label>
                        <select class="form-select form-select-sm" id="cfg-subset-size"></select>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <label class="form-label">Epochs</label>
                        <input type="number" class="form-control form-control-sm" id="cfg-epochs" min="1" max="200" />
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <label class="form-label">Learning rate</label>
                        <input type="number" class="form-control form-control-sm" id="cfg-lr" step="0.00001" />
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <label class="form-label">Batch size</label>
                        <input type="number" class="form-control form-control-sm" id="cfg-batch" min="1" max="128" />
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <label class="form-label">Val ratio</label>
                        <input type="number" class="form-control form-control-sm" id="cfg-val-ratio" step="0.05" min="0.05" max="0.5" />
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <label class="form-label">Early stopping patience</label>
                        <input type="number" class="form-control form-control-sm" id="cfg-patience" min="0" max="50" />
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <label class="form-label">CPU workers</label>
                        <input type="number" class="form-control form-control-sm" id="cfg-workers" min="0" max="16" />
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <label class="form-label">Random seed</label>
                        <input type="number" class="form-control form-control-sm" id="cfg-seed" />
                    </div>
                    <div class="col-md-4 col-sm-6">
                        <label class="form-label">Resume checkpoint</label>
                        <input type="text" class="form-control form-control-sm" id="cfg-resume" placeholder="Optional path" />
                    </div>
                    <div class="col-md-4 col-sm-6">
                        <label class="form-label">Finetune from checkpoint</label>
                        <input type="text" class="form-control form-control-sm" id="cfg-finetune" placeholder="Optional path" />
                    </div>
                    <div class="col-md-4 col-sm-6 d-flex align-items-end gap-3 flex-wrap">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="cfg-freeze" checked />
                            <label class="form-check-label" for="cfg-freeze">Freeze backbone</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="cfg-unfreeze-block" />
                            <label class="form-check-label" for="cfg-unfreeze-block">Unfreeze last block</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="cfg-save-best" checked disabled />
                            <label class="form-check-label" for="cfg-save-best">Save best model</label>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <!-- Section 4: Start Training -->
    <section class="ftc-section" id="ftc-section-start">
        <button class="ftc-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#ftc-collapse-start" aria-expanded="true">
            <span><i class="bi bi-play-circle"></i> Start Fine-Tuning</span>
            <i class="bi bi-chevron-down"></i>
        </button>
        <div class="collapse show" id="ftc-collapse-start">
            <div class="ftc-section-body text-center py-3">
                <button type="button" class="btn btn-lg ftc-start-btn" id="ftc-start-btn">
                    <i class="bi bi-lightning-charge"></i> Start Fine-Tuning
                </button>
                <p class="text-muted small mt-2 mb-0" id="ftc-selected-model-label">Select a model above to configure training.</p>
            </div>
        </div>
    </section>

            <section class="ftc-section" id="ftc-section-queue">
                <button class="ftc-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#ftc-collapse-queue" aria-expanded="true">
                    <span><i class="bi bi-list-ol"></i> Training Queue</span>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <div class="collapse show" id="ftc-collapse-queue">
                    <div class="ftc-section-body">
                        <div class="table-responsive">
                            <table class="table table-sm ftc-table" id="ftc-queue-table">
                                <thead><tr><th>#</th><th>Model</th><th>Dataset</th><th>Requested By</th><th>Time</th><th>Status</th><th></th></tr></thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </section>
    <section class="ftc-section" id="ftc-section-monitor">
        <button class="ftc-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#ftc-collapse-monitor" aria-expanded="true">
            <span><i class="bi bi-activity"></i> Live Training Monitor</span>
            <span class="ftc-badge ftc-badge-live" id="ftc-monitor-badge">Idle</span>
            <i class="bi bi-chevron-down"></i>
        </button>
        <div class="collapse show" id="ftc-collapse-monitor">
            <div class="ftc-section-body" id="ftc-monitor-panel">
                <p class="text-muted small">No active training job. Auto-refreshes every @Model.LiveRefreshSeconds seconds when running.</p>
            </div>
        </div>
    </section>

            <section class="ftc-section" id="ftc-section-console">
                <button class="ftc-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#ftc-collapse-console" aria-expanded="true">
                    <span><i class="bi bi-terminal"></i> Training Console</span>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <div class="collapse show" id="ftc-collapse-console">
                    <div class="ftc-section-body">
                        <pre class="ftc-console-output" id="ftc-console-output">No active training output.</pre>
                    </div>
                </div>
            </section>

    <!-- Section 6: Training Charts -->
    <section class="ftc-section" id="ftc-section-charts">
        <button class="ftc-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#ftc-collapse-charts">
            <span><i class="bi bi-graph-up"></i> Training Charts</span>
            <i class="bi bi-chevron-down"></i>
        </button>
        <div class="collapse" id="ftc-collapse-charts">
            <div class="ftc-section-body">
                <div class="row g-3">
                    <div class="col-lg-6"><div class="ftc-chart-wrap"><canvas id="chart-train-loss"></canvas></div></div>
                    <div class="col-lg-6"><div class="ftc-chart-wrap"><canvas id="chart-val-loss"></canvas></div></div>
                    <div class="col-lg-6"><div class="ftc-chart-wrap"><canvas id="chart-f1"></canvas></div></div>
                    <div class="col-lg-6"><div class="ftc-chart-wrap"><canvas id="chart-roc"></canvas></div></div>
                </div>
            </div>
        </div>
    </section>

            <section class="ftc-section" id="ftc-section-inference-test">
                <button class="ftc-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#ftc-collapse-inference">
                    <span><i class="bi bi-eye"></i> Inference Test (Pre-Deployment)</span>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <div class="collapse" id="ftc-collapse-inference">
                    <div class="ftc-section-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <input type="file" class="form-control form-control-sm" id="ftc-infer-image" accept="image/*,.dcm" />
                                <select class="form-select form-select-sm mt-2" id="ftc-infer-mode">
                                    <option value="compare">Compare Production vs Candidate</option>
                                    <option value="production">Production only</option>
                                    <option value="candidate">Candidate only</option>
                                </select>
                                <input type="text" class="form-control form-control-sm mt-2" id="ftc-infer-checkpoint" placeholder="Candidate checkpoint path" />
                                <button type="button" class="btn btn-sm btn-primary mt-2" id="ftc-infer-run">Run inference test</button>
                            </div>
                            <div class="col-md-8"><div class="row g-2" id="ftc-infer-results"></div></div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="ftc-section" id="ftc-section-recommendation">
                <button class="ftc-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#ftc-collapse-recommendation">
                    <span><i class="bi bi-stars"></i> AI Recommendation</span>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <div class="collapse" id="ftc-collapse-recommendation">
                    <div class="ftc-section-body" id="ftc-recommendation-panel"></div>
                </div>
            </section>
        </div>

        <div class="tab-pane fade" id="ftc-tab-experiments">
            <section class="ftc-section" id="ftc-section-experiments">
                <button class="ftc-section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#ftc-collapse-experiments" aria-expanded="true">
                    <span><i class="bi bi-bezier2"></i> Experiment Comparison Center</span>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <div class="collapse show" id="ftc-collapse-experiments">
                    <div class="ftc-section-body">
                        <div class="table-responsive mb-3">
                            <table class="table table-sm ftc-table" id="ftc-experiments-table">
                                <thead><tr><th></th><th>Experiment</th><th>Model</th><th>Epochs</th><th>LR</th><th>F1</th><th>ROC-AUC</th><th>Val Loss</th></tr></thead>
                                <tbody></tbody>
                            </table>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="ftc-compare-experiments">Compare selected experiments</button>
                        <div id="ftc-experiment-compare" class="mt-3"></div>
                    </div>
                </div>
            </section>
            <section class="ftc-section" id="ftc-section-threshold">
