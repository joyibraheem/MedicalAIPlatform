@model MedicalAIPlatform.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_DoctorLayout";
}

<link rel="stylesheet" href="~/css/doctor-dashboard.css" asp-append-version="true" />

<!-- Page Header (Greeting) -->
<div class="dash-header">
    <div class="user-greeting">
        <img src="https://ui-avatars.com/api/?name=Admin&background=1D4581&color=fff" class="user-avatar-small" alt="Admin Profile">
        <div class="greeting-text">
            <h2><span data-i18n="dashboard_good_morning">Good Morning</span> Admin</h2>
            <p>Welcome to the Admin Dashboard</p>
        </div>
    </div>
    <!-- Actions -->
    <div class="header-actions">
        <button class="icon-btn" title="Notifications">
            <i class="bi bi-bell-fill" style="color:#1e293b;"></i>
        </button>
    </div>
</div>

<!-- Stats Stack -->
<div class="stats-stack">
    <!-- Active Doctors -->
    <div class="dash-stat-card">
        <div class="stat-icon-circle bg-icon-blue">
            <i class="bi bi-people-fill"></i>
        </div>
        <div class="stat-content">
            <h3>@Model.ActiveDoctorsCount.ToString("00")</h3>
            <p>Active Doctors</p>
        </div>
    </div>

    <!-- Patients -->
    <div class="dash-stat-card">
        <div class="stat-icon-circle bg-icon-green">
            <i class="bi bi-person-heart"></i>
        </div>
        <div class="stat-content">
            <h3>@Model.PatientsCount.ToString("00")</h3>
            <p>Patients</p>
        </div>
    </div>

    <!-- Accuracy Rate -->
    <div class="dash-stat-card">
        <div class="stat-icon-circle bg-icon-purple">
            <i class="bi bi-graph-up-arrow"></i>
        </div>
        <div class="stat-content">
            <h3>@Model.AccuracyRate.ToString("0.0")%</h3>
            <p>Accuracy Rate</p>
        </div>
    </div>
</div>

<!-- Accuracy Progress Bar -->
<div class="upload-card" style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h3 style="margin: 0; font-size: 1.1rem; font-weight: 600; color: #1e293b;">System Accuracy</h3>
        <span style="font-size: 1.5rem; font-weight: 700; color: #1D4581;">@Model.AccuracyRate%</span>
    </div>
    <div class="progress-container" style="background: rgba(255, 255, 255, 0.5); border-radius: 12px; height: 12px; overflow: hidden;">
        <div class="progress-fill" style="background: linear-gradient(90deg, #1D4581 0%, #127FEC 100%); height: 100%; width: @Model.AccuracyRate%; border-radius: 12px; transition: width 0.3s ease;"></div>
    </div>
</div>

<!-- Pending Approvals Section -->
<div class="latest-scans-section">
    <div class="scans-header">
        <h4>Pending Approvals</h4>
        @if (Model.PendingDoctors.Any())
        {
            <a asp-controller="Admin" asp-action="PendingDoctors" class="link-see-all">View all</a>
        }
    </div>

    @if (Model.PendingDoctors.Any())
    {
        @foreach (var doctor in Model.PendingDoctors)
        {
            <div class="scan-list-item" style="background: rgba(255, 255, 255, 0.45); border: 1px solid rgba(255, 255, 255, 0.5); border-radius: 16px; padding: 1rem; margin-bottom: 0.75rem;">
                <div class="scan-user-info">
                    <img src="https://ui-avatars.com/api/?name=@doctor.FullName&background=random&color=fff" class="scan-avatar" alt="@doctor.FullName">
                    <div class="scan-text">
                        <h5 style="margin: 0; font-size: 1rem; font-weight: 600; color: #1e293b;">Dr. @doctor.FullName</h5>
                        <p style="margin: 4px 0 0; font-size: 0.85rem; color: #64748b;">@doctor.Specialization</p>
                    </div>
                </div>
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <form asp-controller="Admin" asp-action="RejectDoctor" method="post" style="margin: 0;">
                        <input type="hidden" name="userId" value="@doctor.Id" />
                        <button type="submit" class="icon-btn" style="background: rgba(239, 68, 68, 0.1); border-color: rgba(239, 68, 68, 0.3);" title="Reject">
                            <i class="bi bi-x-lg" style="color: #ef4444;"></i>
                        </button>
                    </form>
                    <form asp-controller="Admin" asp-action="ApproveDoctor" method="post" style="margin: 0;">
                        <input type="hidden" name="userId" value="@doctor.Id" />
                        <button type="submit" style="background: linear-gradient(135deg, #1D4581 0%, #127FEC 100%); color: white; border: none; border-radius: 12px; padding: 0.5rem 1.25rem; font-weight: 600; font-size: 0.9rem; cursor: pointer; transition: all 0.3s ease;">
                            Approve
                        </button>
                    </form>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center" style="opacity: 0.6; padding: 2rem; color: #64748b;">
            <i class="bi bi-check-circle-fill" style="font-size: 2rem; margin-bottom: 0.5rem; display: block; color: #10b981;"></i>
            <p style="margin: 0;">No pending approvals</p>
        </div>
    }
</div>

<!-- System Activity Section -->
<div class="upload-card" style="margin-top: 2rem;">
    <h3 style="margin: 0 0 1rem 0; font-size: 1.1rem; font-weight: 600; color: #1e293b;">System Activity</h3>
    <div style="display: flex; flex-direction: column; gap: 0.75rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
            <span class="dot @(Model.IsSystemWorking ? "green" : "red")" style="width: 12px; height: 12px; border-radius: 50%; display: inline-block;"></span>
            <span style="color: #64748b; font-size: 0.9rem;">@(Model.IsSystemWorking ? "The system is working" : "The system is not working")</span>
        </div>
        @if (!Model.IsSystemWorking)
        {
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <span class="dot green" style="width: 12px; height: 12px; border-radius: 50%; display: inline-block;"></span>
                <span style="color: #64748b; font-size: 0.9rem;">The system is working</span>
            </div>
        }
    </div>
</div>

<style>
    .dot.red {
        background-color: #ef4444;
        box-shadow: 0 0 8px rgba(239, 68, 68, 0.5);
    }
    
    .dot.green {
        background-color: #10b981;
        box-shadow: 0 0 8px rgba(16, 185, 129, 0.5);
    }
    
    .bg-icon-green {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    }
    
    .bg-icon-purple {
        background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
    }
</style>

