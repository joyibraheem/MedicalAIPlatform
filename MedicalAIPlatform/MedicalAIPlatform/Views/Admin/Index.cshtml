@model MedicalAIPlatform.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <script>
        (function () {
            const theme = localStorage.getItem("theme");
            document.documentElement.setAttribute(
                "data-theme",
                theme === "dark" ? "dark" : "light"
            );
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MedicalAIPlatform</title>
    <partial name="_GlobalSettingsLogic" />
    <!-- SVGs for Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <style>
        #darkOverlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.75);
            z-index: 9998;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.25s ease;
        }

        html[data-theme="dark"] #darkOverlay {
            opacity: 1;
        }
    </style>
</head>
<body>
    <div id="darkOverlay"></div>

    <!-- The Central App Frame -->
    <div class="app-frame">
        
        <!-- Header -->
        <!-- Header -->
        <header class="app-header">
            <div class="header-left">
                <div class="logo-container">
                     <!-- ChestAI Logo -->
                     <img src="~/images/chest-icon.png" alt="ChestAI" class="logo-icon" style="width: 36px; height: 36px; border-radius: 6px;" />
                    <span class="brand-name">ChestAI</span>
                </div>
                <nav class="main-nav">
                    <a asp-controller="Home" asp-action="Index" class="nav-link active" data-i18n="nav_home">Home</a>
                    <a asp-controller="FollowUp" asp-action="Index" class="nav-link" data-i18n="nav_follow_up">Follow up</a>
                    <a asp-controller="PatientCalendar" asp-action="Index" class="nav-link" data-i18n="nav_calendar">Calendar</a>
                    <a asp-controller="Dashboard" asp-action="Index" class="nav-link" data-i18n="nav_analytics">Analytics</a>
                    <a asp-controller="Settings" asp-action="Index" class="nav-link" data-i18n="nav_ai_assistant">AI Assistant</a>
                </nav>
            </div>
            
            <div class="header-right">
                <!-- Logout Link -->
                <a asp-controller="Account" asp-action="Logout" class="nav-link" style="text-decoration:none; color:inherit;">
                    <div style="cursor:pointer; font-weight:500; font-size:1rem; color: #6B7280; display:flex; align-items:center; gap:8px;">
                         <span data-i18n="nav_logout">Logout</span>
                         <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                           <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                         </svg>
                    </div>
                </a>
            </div>
        </header>

        <div class="app-content">

            <!-- Stats Row -->
            <div class="stats-row">
                <div class="mini-card">
                    <div class="mini-card-label">Active Doctors</div>
                    <div class="mini-card-value">@Model.ActiveDoctorsCount.ToString("N0")</div>
                     <!-- Decorative graph wave -->
                     <svg class="bg-wave" viewBox="0 0 100 40" preserveAspectRatio="none">
                        <path d="M0,40 C20,20 40,30 60,10 C80,-10 90,20 100,30 V40 H0 Z" fill="white"/>
                     </svg>
                </div>
                <div class="mini-card">
                    <div class="mini-card-label">Patients</div>
                    <div class="mini-card-value">@Model.PatientsCount.ToString("N0")</div>
                    <!-- Decorative graph bars -->
                     <svg class="bg-wave" style="opacity:0.2;" viewBox="0 0 100 40" preserveAspectRatio="none">
                        <rect x="10" y="20" width="8" height="20" fill="white"/>
                        <rect x="25" y="10" width="8" height="30" fill="white"/>
                        <rect x="40" y="15" width="8" height="25" fill="white"/>
                        <rect x="55" y="5" width="8" height="35" fill="white"/>
                        <rect x="70" y="25" width="8" height="15" fill="white"/>
                        <rect x="85" y="12" width="8" height="28" fill="white"/>
                     </svg>
                </div>
            </div>

            <!-- Accuracy Section -->
            <div class="accuracy-section">
                <div class="accuracy-header">
                    <div class="accuracy-label">Accuracy Rate</div>
                    <div class="accuracy-percent">@Model.AccuracyRate%</div>
                </div>
                <div class="progress-container">
                    <div class="progress-fill" style="width: @Model.AccuracyRate%"></div>
                </div>
            </div>

            <!-- Pending Approvals -->
            <div class="list-header">
                <div class="list-title">Pending Approvals</div>
                <a asp-controller="Admin" asp-action="PendingDoctors" class="view-all">View all</a>
            </div>

            <div class="doctor-list">
                 @if (Model.PendingDoctors.Any())
                {
                    @foreach (var doctor in Model.PendingDoctors)
                    {
                        <div class="doctor-item">
                            <div class="doctor-profile">
                                <img src="https://ui-avatars.com/api/?name=@doctor.FullName&background=random&color=fff&size=128" class="avatar" alt="@doctor.FullName" />
                                <div class="info-col">
                                    <span class="name-text">Dr. @doctor.FullName</span>
                                    <span class="spec-text">@doctor.Specialization</span>
                                </div>
                            </div>
                            <div class="action-row" style="display:flex; align-items:center; gap:10px;">
                                 <form asp-controller="Admin" asp-action="RejectDoctor" method="post" style="margin:0;">
                                    <input type="hidden" name="userId" value="@doctor.Id" />
                                    <button type="submit" class="btn-reject-x" title="Reject">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </form>
                                <form asp-controller="Admin" asp-action="ApproveDoctor" method="post" style="margin:0;">
                                    <input type="hidden" name="userId" value="@doctor.Id" />
                                    <button type="submit" class="btn-approve-sm">Approve</button>
                                </form>
                            </div>
                        </div>
                    }
                } 
                else 
                {
                    <div class="text-center" style="opacity:0.6; padding: 20px;">No pending approvals</div>
                }
            </div>

            <!-- System Activity (Footer) -->
            <div class="activity-section">
                <div class="activity-title">System Activity</div>
                <div class="activity-row">
                    <span class="dot red"></span>
                    <span>the system is not working</span>
                </div>
                 <div class="activity-row">
                    <span class="dot green"></span>
                    <span>the system is working</span>
                </div>
            </div>
            
            <!-- Floating Settings Button (Added manually since Layout=null) -->
            <a asp-controller="Settings" asp-action="Index" class="settings-fab">
                <i class="bi bi-gear-wide-connected"></i>
            </a>
            
        </div> <!-- End app-content -->

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/i18n.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>

