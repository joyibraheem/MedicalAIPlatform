@model IEnumerable<MedicalAIPlatform.Models.ApplicationUser>
@using MedicalAIPlatform.Models
@{
    ViewData["Title"] = "Pending Doctor Requests";
    Layout = "_DoctorLayout";
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />

<div class="admin-dash-root">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Pending doctor requests</h1>
            <p class="text-muted mb-0">Registrations awaiting credentialing review.</p>
        </div>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-sm admin-btn-outline">← Admin dashboard</a>
    </div>

    @if (TempData["AdminError"] is string err)
    {
        <div class="alert alert-danger">@err</div>
    }

    <div class="admin-card">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Specialty</th>
                            <th>Hospital</th>
                            <th>License</th>
                            <th>Submitted</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@(user.FullName ?? "—")</td>
                                <td>@user.Email</td>
                                <td>@(user.Specialization ?? "—")</td>
                                <td>@(user.HospitalOrganization ?? "—")</td>
                                <td><code>@(user.MedicalLicenseNumber ?? "—")</code></td>
                                <td>@(user.ProfileSubmittedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                <td><span class="badge bg-warning text-dark">@user.DoctorStatus</span></td>
                                <td class="text-end">
                                    <div class="d-flex gap-2 justify-content-end flex-wrap">
                                        <a asp-action="DoctorDetails" asp-route-userId="@user.Id" class="btn btn-sm btn-outline-primary">View details</a>
                                        <form asp-action="ApproveDoctor" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="admin-empty-inline p-4">
                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                No submitted registration requests at this time.
            </div>
        }
    </div>
</div>
