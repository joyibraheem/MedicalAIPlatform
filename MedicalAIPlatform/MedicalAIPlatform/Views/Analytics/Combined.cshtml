@{
    ViewData["Title"] = "Combined Analysis";
    Layout = "_DoctorLayout";
}
@using MedicalAIPlatform.Models
@using MedicalAIPlatform.Services
@inject AnalyticsStateService StateService

<link rel="stylesheet" href="~/css/analytics.css" asp-append-version="true" />

<div class="analytics-container">
    <div class="analytics-overlay">
        <!-- Doctor Information Header -->
        <div class="patient-header">
            <button class="back-button" onclick="window.location.href='@Url.Action("Index", "Analytics")'">
                <i class="bi bi-arrow-left"></i>
            </button>
            <div class="patient-info">
                <div class="patient-name">@(ViewBag.DoctorName ?? "Doctor")</div>
            </div>
        </div>

        <!-- Diagnostic Command Center Title -->
        <div class="command-center-title">
            <h1 data-i18n="analytics_diagnostic_command_center">Diagnostic Command Center</h1>
            <p data-i18n="analytics_multi_modal_system">Multi-modal AI Analysis System</p>
        </div>

        @{
            var combinedWarnings = TempData["CombinedWarnings"] as string;
        }
        @if (!string.IsNullOrWhiteSpace(combinedWarnings))
        {
            <div class="alert alert-warning results-card mb-3" role="status">
                <strong>Partial combined run:</strong>
                <span class="ms-1">@combinedWarnings</span>
            </div>
        }

        @if (StateService.PipelineNotes.Count > 0)
        {
            <div class="alert alert-info border-info results-card mb-3" role="status">
                @foreach (var note in StateService.PipelineNotes)
                {
                    <div class="small mb-1">@note</div>
                }
            </div>
        }

        @if (StateService.CurrentResults == null && StateService.CurrentBioBertResults == null && StateService.CurrentLungAIResults == null)
        {
            <div class="results-card">
                <p>No analysis results available. Please go back and run an analysis.</p>
                <button class="action-btn btn-xray" onclick="window.location.href='@Url.Action("Index", "Analytics")'" data-i18n="analytics_go_back">Go Back</button>
            </div>
        }
        else
        {
            <!-- X-Ray Results -->
            @if (StateService.CurrentResults != null && StateService.CurrentResults.ContainsKey("CheXNet"))
            {
                var xrayResult = StateService.CurrentResults["CheXNet"];
                var xrayProbs = xrayResult.Probabilities ?? new Dictionary<string, double>(StringComparer.Ordinal);
                var previewUrl = !string.IsNullOrEmpty(xrayResult.PreviewImageDataUrl)
                    ? xrayResult.PreviewImageDataUrl
                    : StateService.XRayImageDataUrl;
                var heatmapUrl = xrayResult.Heatmap?.DataUrl;
                var heatmapClass = xrayResult.Heatmap?.ClassName;
                <div class="results-card">
                    <h2 class="findings-title" data-i18n="analytics_findings_reports">Findings Reports</h2>
                    <a class="model-link" href="#">X-Ray-CheXNet:CheXNet</a>

                    <div class="row mt-4">
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <span class="small fw-bold text-slate-500">Pathology Probabilities</span>
                                <span class="small text-muted float-end">Confidence Index</span>
                            </div>
                            @if (!xrayProbs.Any())
                            {
                                <p class="text-muted mb-0">No pathology scores were returned for this study. Check that the inference service responded with probabilities, then try again.</p>
                            }
                            else
                            {
                                <ul class="pathology-list">
                                    @foreach (var item in xrayProbs.OrderByDescending(kv => kv.Value))
                                    {
                                        var percentage = Math.Clamp(item.Value * 100.0, 0, 100);
                                        <li class="pathology-item">
                                            <div class="pathology-label">
                                                <span class="pathology-name">@item.Key</span>
                                                <span class="pathology-percentage">@percentage.ToString("F0")%</span>
                                            </div>
                                            <div class="pathology-bar">
                                                <div class="pathology-bar-fill" style="width: @percentage.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>

                        <div class="col-lg-6">
                            @if (!string.IsNullOrEmpty(previewUrl) || !string.IsNullOrEmpty(heatmapUrl))
                            {
                                <div class="analytics-image-duo">
                                    @if (!string.IsNullOrEmpty(previewUrl))
                                    {
                                        <div class="analytics-side-panel">
                                            <div class="analytics-side-caption" data-i18n="analytics_rendered_slice">Rendered slice</div>
                                            <div class="xray-display analytics-side-frame">
                                                <img src="@previewUrl" class="xray-image" alt="Chest study" />
                                            </div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(heatmapUrl))
                                    {
                                        <div class="analytics-side-panel">
                                            <div class="analytics-side-caption">
                                                <span data-i18n="analytics_attention_heatmap">Attention heatmap</span>@if (!string.IsNullOrWhiteSpace(heatmapClass))
                                                {<span class="text-muted">&nbsp;(@heatmapClass)</span>}
                                            </div>
                                            <div class="xray-display analytics-side-frame">
                                                <img src="@heatmapUrl" class="xray-image" alt="Attention heatmap" />
                                            </div>
                                        </div>
                                    }
                                </div>

                                @if (!string.IsNullOrEmpty(previewUrl) && !string.IsNullOrEmpty(heatmapUrl))
                                {
                                    <div class="mt-4">
                                        <div class="analytics-side-caption mb-2" data-i18n="analytics_overlay_view">Overlay (adjust opacity)</div>
                                        <div class="xray-display">
                                            <img src="@previewUrl" class="xray-image" alt="" />
                                            <img src="@heatmapUrl"
                                                 class="heatmap-overlay-img"
                                                 id="heatmapOverlay"
                                                 style="opacity: 0.5"
                                                 alt="" />
                                        </div>
                                        <div class="heatmap-control">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <label class="small fw-bold" data-i18n="analytics_heatmap_opacity">Heatmap Opacity</label>
                                                <span class="badge bg-light text-dark" id="opacityValue">50%</span>
                                            </div>
                                            <input type="range"
                                                   class="heatmap-slider"
                                                   id="heatmapSlider"
                                                   min="0"
                                                   max="100"
                                                   value="50"
                                                   oninput="updateHeatmapOpacity(this.value)" />
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <partial name="_ClinicalPredictionFeedback" model="ClinicalFeedbackVmBuilder.FromCheXNet(xrayResult, StateService)" />
                </div>
            }

            <!-- Text Results -->
            @if (StateService.CurrentBioBertResults != null)
            {
                <div class="results-card">
                    <h2 class="findings-title" data-i18n="analytics_findings_reports">Findings Reports</h2>
                    <a class="model-link" href="#">Clinical Text-BioBERT(NLP)</a>

                    <div class="mt-4">
                        <h3 class="findings-title" style="font-size: 1.1rem; margin-bottom: 1rem;" data-i18n="analytics_key_medical_entities">Key Medical Entities</h3>
                        @{
                            var bioEntities = (StateService.CurrentBioBertResults.Entities ?? []).OrderByDescending(e => e.Score).ToList();
                        }
                        @if (!bioEntities.Any())
                        {
                            <p class="text-muted mb-0">No medical entities were extracted from the clinical text.</p>
                        }
                        else
                        {
                            <div class="entities-container">
                            @foreach (var entity in bioEntities)
                            {
                                <div class="entity-badge">
                                    <span class="entity-name">@entity.Word</span>
                                    <span class="entity-type">@entity.EntityGroup</span>
                                </div>
                            }
                            </div>
                        }
                    </div>

                    <partial name="_ClinicalPredictionFeedback" model="ClinicalFeedbackVmBuilder.FromBio(StateService.CurrentBioBertResults, StateService)" />
                </div>
            }

            <!-- CT Results -->
            @if (StateService.CurrentLungAIResults != null && !string.IsNullOrEmpty(StateService.CurrentLungAIResults.Error))
            {
                <div class="results-card border border-warning shadow-sm">
                    <h2 class="findings-title">CT Scan-ChestAI (branch issue)</h2>
                    <p class="alert alert-warning mb-0">
                        @(StateService.CurrentLungAIResults.Error)
                    </p>
                </div>
            }

            @if (StateService.CurrentLungAIResults != null && string.IsNullOrEmpty(StateService.CurrentLungAIResults.Error))
            {
                <div class="results-card">
                    <h2 class="findings-title" data-i18n="analytics_findings_reports">Findings Reports</h2>
                    <a class="model-link" href="#">CT Scan-ChestAI (Chest Clarification)</a>

                    <div class="row mt-4">
                        <div class="col-md-6">
                            <div class="predicted-class">
                                <div class="predicted-class-label" data-i18n="analytics_predicted_class">Predicted Class</div>
                                <div class="predicted-class-value">@StateService.CurrentLungAIResults.PredictedClass</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="class-probabilities">
                                <div class="predicted-class-label mb-3" data-i18n="analytics_class_probabilities">Class Probabilities</div>
                                @{ var lungProbs = StateService.CurrentLungAIResults.Probabilities ?? new Dictionary<string, double>(StringComparer.OrdinalIgnoreCase); }
                                @if (!lungProbs.Any())
                                {
                                    <p class="text-muted mb-0">No class probabilities in the response.</p>
                                }
                                @foreach (var kv in lungProbs.OrderByDescending(x => x.Value))
                                {
                                    var percentage = Math.Clamp(kv.Value * 100.0, 0, 100);
                                    <div class="class-prob-item">
                                        <div class="class-prob-label">
                                            <span class="class-prob-name">@kv.Key</span>
                                            <span class="class-prob-percentage">@percentage.ToString("F0")%</span>
                                        </div>
                                        <div class="class-prob-bar">
                                            <div class="class-prob-bar-fill" style="width: @percentage.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(StateService.CTImageDataUrl))
                    {
                        <div class="mt-4">
                            <div class="analytics-side-caption mb-2" data-i18n="analytics_rendered_slice">Rendered slice</div>
                            <div class="xray-display analytics-side-frame">
                                <img src="@StateService.CTImageDataUrl" class="xray-image" alt="CT Scan" />
                            </div>
                        </div>
                    }

                    <partial name="_ClinicalPredictionFeedback" model="ClinicalFeedbackVmBuilder.FromLung(StateService.CurrentLungAIResults!, StateService)" />
                </div>
            }
        }
    </div>

</div>

@section Scripts {
    <script>
        function updateHeatmapOpacity(value) {
            const overlay = document.getElementById('heatmapOverlay');
            const valueSpan = document.getElementById('opacityValue');
            if (overlay) {
                overlay.style.opacity = value / 100;
            }
            if (valueSpan) {
                valueSpan.textContent = value + '%';
            }
        }
    </script>
}
