@model MedicalAIPlatform.Models.SettingsViewModel
@{
    ViewData["Title"] = "Settings";
    Layout = "_DoctorLayout";
    var hasUserId = !string.IsNullOrEmpty(Model.UserId);
    var safeLang = Model.Language == "ar" ? "ar" : "en";
}

<link rel="stylesheet" href="~/css/settings.css" asp-append-version="true" />

@Html.AntiForgeryToken()

<div class="settings-dashboard settings-content">
    <header class="settings-page-hero">
        <div class="settings-page-hero-text">
            <p class="settings-kicker" data-i18n="settings_workspace_label">Clinical workspace</p>
            <h1 class="settings-page-title" data-i18n="settings_title">Settings &amp; Help</h1>
            <p class="settings-page-lead" data-i18n="settings_dashboard_lead">Manage profile, security cues, and workspace preferences in one place.</p>
        </div>
    </header>

    <div class="row g-4 align-items-stretch settings-grid">
        <!-- Profile -->
        <div class="col-12">
            <article class="sd-card sd-card-profile">
                <div class="sd-card-head">
                    <div class="sd-card-head-icon" aria-hidden="true"><i class="bi bi-person-badge"></i></div>
                    <div>
                        <h2 class="sd-card-title" data-i18n="settings_profile_information">Profile information</h2>
                        <p class="sd-card-desc" data-i18n="settings_profile_information_desc">Verified identity used across imaging workflows and audit trails.</p>
                    </div>
                </div>
                <div class="sd-profile-layout">
                    <div class="sd-profile-avatar-block">
                        <div class="profile-avatar-wrapper sd-profile-avatar-wrap">
                            <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(Model.FullName)&background=0f172a&color=e2e8f0&size=128"
                                 alt="" class="profile-avatar" width="96" height="96" />
                            <div class="verified-badge" title="Verified account"><i class="bi bi-check-lg"></i></div>
                        </div>
                        <div class="sd-profile-name-block">
                            <h3 class="sd-profile-name">@Model.FullName</h3>
                            @if (!string.IsNullOrWhiteSpace(Model.Specialization))
                            {
                                <p class="sd-profile-specialization">@Model.Specialization</p>
                            }
                            <span class="sd-role-pill">@Model.RoleDisplay</span>
                        </div>
                    </div>
                    <dl class="sd-dl-grid">
                        <div class="sd-dl-item">
                            <dt data-i18n="settings_full_name">Full name</dt>
                            <dd>@(string.IsNullOrWhiteSpace(Model.FullName) ? "—" : Model.FullName)</dd>
                        </div>
                        <div class="sd-dl-item sd-dl-item-id">
                            <dt data-i18n="settings_id">User ID</dt>
                            <dd class="sd-id-row">
                                @if (hasUserId)
                                {
                                    <code class="sd-id-value" id="settingsUserIdDisplay">@Model.UserId</code>
                                    <button type="button" class="btn btn-sm sd-btn-copy" id="btnCopyUserId" title="Copy user ID">
                                        <i class="bi bi-clipboard"></i><span data-i18n="settings_copy">Copy</span>
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </dd>
                        </div>
                        <div class="sd-dl-item">
                            <dt data-i18n="settings_email">Email</dt>
                            <dd>@(string.IsNullOrWhiteSpace(Model.Email) ? "—" : Model.Email)</dd>
                        </div>
                        <div class="sd-dl-item">
                            <dt data-i18n="settings_role_label">Role</dt>
                            <dd>@Model.RoleDisplay</dd>
                        </div>
                    </dl>
                </div>
            </article>
        </div>

        <!-- Account -->
        <div class="col-12 col-lg-6">
            <article class="sd-card sd-card-tall">
                <div class="sd-card-head">
                    <div class="sd-card-head-icon sd-icon-account" aria-hidden="true"><i class="bi bi-shield-lock"></i></div>
                    <div>
                        <h2 class="sd-card-title" data-i18n="settings_account_security">Account &amp; security</h2>
                        <p class="sd-card-desc" data-i18n="settings_account_security_desc">Credentials and session posture for this workstation.</p>
                    </div>
                </div>

                <div class="sd-security-strip">
                    <div class="sd-security-item">
                        <span class="sd-security-label" data-i18n="settings_last_login">Last activity</span>
                        <span class="sd-security-value">@Model.LastLoginDisplay</span>
                    </div>
                    <div class="sd-security-item">
                        <span class="sd-security-label" data-i18n="settings_account_status">Account status</span>
                        <span class="sd-status-active"><i class="bi bi-circle-fill"></i>@Model.AccountStatusDisplay</span>
                    </div>
                </div>

                <div class="sd-account-actions">
                    <button type="button" class="btn sd-btn-primary" id="btnChangePassword" disabled data-i18n="settings_change_password">
                        Change password
                    </button>
                    <p class="sd-placeholder-hint" data-i18n="settings_change_password_hint">Self-service password updates will be enabled in a future release.</p>
                </div>
            </article>
        </div>

        <!-- Preferences -->
        <div class="col-12 col-lg-6">
            <article class="sd-card sd-card-tall">
                <div class="sd-card-head">
                    <div class="sd-card-head-icon sd-icon-prefs" aria-hidden="true"><i class="bi bi-sliders"></i></div>
                    <div>
                        <h2 class="sd-card-title" data-i18n="settings_system_preferences">System preferences</h2>
                        <p class="sd-card-desc" data-i18n="settings_system_preferences_desc">Theme and locale apply to this browser immediately.</p>
                    </div>
                </div>

                <div class="sd-pref-row sd-pref-row-narrow" id="darkModeCard">
                    <div class="sd-pref-label">
                        <i class="bi bi-moon-stars sd-pref-inline-icon" aria-hidden="true"></i>
                        <div>
                            <div class="sd-pref-title" data-i18n="settings_dark_mode">Dark mode</div>
                            <div class="sd-pref-sub" data-i18n="settings_dark_mode_desc">Reduce glare in reading rooms</div>
                        </div>
                    </div>
                    <label class="sd-switch" aria-label="Toggle dark mode">
                        <input class="sd-switch-input" type="checkbox" role="switch" id="darkModeSwitch" checked="@Model.IsDarkMode" />
                        <span class="sd-switch-track" aria-hidden="true"><span class="sd-switch-thumb"></span></span>
                    </label>
                </div>

                <div class="sd-pref-row sd-pref-language">
                    <div class="sd-pref-label">
                        <i class="bi bi-translate sd-pref-inline-icon" aria-hidden="true"></i>
                        <div>
                            <div class="sd-pref-title" data-i18n="settings_language">Language</div>
                            <div class="sd-pref-sub" data-i18n="settings_language_desc">Clinical UI strings</div>
                        </div>
                    </div>
                    <div class="sd-select-wrap">
                        <select id="languageSelect" class="sd-select" aria-label="Language">
                            @if (safeLang == "en")
                            {
                                <option value="en" selected>🇺🇸 English (US)</option>
                            }
                            else
                            {
                                <option value="en">🇺🇸 English (US)</option>
                            }
                            @if (safeLang == "ar")
                            {
                                <option value="ar" selected>🇸🇦 العربية</option>
                            }
                            else
                            {
                                <option value="ar">🇸🇦 العربية</option>
                            }
                        </select>
                    </div>
                </div>
            </article>
        </div>

        <!-- Help -->
        <div class="col-12">
            <article class="sd-card sd-card-help">
                <div class="sd-card-head">
                    <div class="sd-card-head-icon sd-icon-help" aria-hidden="true"><i class="bi bi-life-preserver"></i></div>
                    <div>
                        <h2 class="sd-card-title" data-i18n="settings_help_support">Help &amp; support</h2>
                        <p class="sd-card-desc" data-i18n="settings_help_support_desc">Resources for operators and clinical IT.</p>
                    </div>
                </div>
                <div class="sd-help-actions">
                    <a class="btn sd-btn-primary" href="mailto:support@medicalai.local?subject=Medical%20AI%20Platform%20support">
                        <i class="bi bi-headset"></i><span data-i18n="settings_contact_support">Contact support</span>
                    </a>
                    <a class="btn sd-btn-secondary" asp-controller="Home" asp-action="Privacy">
                        <i class="bi bi-journal-text"></i><span data-i18n="settings_documentation">Documentation &amp; privacy</span>
                    </a>
                    <div class="sd-about-inline">
                        <span class="sd-about-label" data-i18n="settings_about">About</span>
                        <p class="sd-about-text" data-i18n="settings_about_body">Medical AI Platform orchestrates imaging inference, reporting, and assistant workflows for supervised clinical use.</p>
                    </div>
                </div>
            </article>
        </div>
    </div>

    <div class="settings-session-actions">
        <a asp-controller="Account" asp-action="Logout" class="btn sd-btn-logout">
            <i class="bi bi-box-arrow-right"></i><span data-i18n="settings_logout">Sign out</span>
        </a>
    </div>

    <footer class="settings-dashboard-footer">
        <div class="settings-footer-brand">
            <span class="settings-footer-name">Medical AI Platform</span>
            <span class="settings-footer-version">v@(Model.AppVersion)</span>
        </div>
        <p class="settings-footer-disclaimer" data-i18n="settings_footer_disclaimer">
            For supervised clinical support only — not a substitute for professional judgment or definitive diagnosis.
        </p>
    </footer>
</div>

@section Scripts {
    <script>
        document.body.classList.add('settings-page');

        document.addEventListener('DOMContentLoaded', function () {
            const darkModeSwitch = document.getElementById('darkModeSwitch');
            const languageSelect = document.getElementById('languageSelect');
            const dataLanguage = '@safeLang';
            const dataIsDarkMode = @Model.IsDarkMode.ToString().ToLowerInvariant();
            const copyBtn = document.getElementById('btnCopyUserId');
            const userIdEl = document.getElementById('settingsUserIdDisplay');

            function getAntiForgeryToken() {
                return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            }

            function updateSettings(data) {
                const langFromSelect = languageSelect ? languageSelect.value : dataLanguage;
                const payload = {
                    isDarkMode: darkModeSwitch ? darkModeSwitch.checked : dataIsDarkMode,
                    language: langFromSelect,
                    ...data
                };
                return fetch('@Url.Action("UpdateSettings", "Settings")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify(payload)
                });
            }

            function initializeSettings() {
                const savedTheme = localStorage.getItem('theme');
                const prefs = localStorage.getItem('medicalAiPrefs') ? JSON.parse(localStorage.getItem('medicalAiPrefs')) : null;
                let themeToApply = dataIsDarkMode;
                if (savedTheme === 'dark' || savedTheme === 'light') {
                    themeToApply = savedTheme === 'dark';
                } else if (prefs && typeof prefs.isDarkMode === 'boolean') {
                    themeToApply = prefs.isDarkMode;
                }

                if (typeof window.setTheme === 'function') {
                    window.setTheme(themeToApply);
                } else {
                    document.documentElement.setAttribute('data-theme', themeToApply ? 'dark' : 'light');
                    document.documentElement.classList.toggle('light-mode-global', !themeToApply);
                    document.body.classList.toggle('light-mode', !themeToApply);
                    document.body.classList.toggle('dark-mode', themeToApply);
                    localStorage.setItem('theme', themeToApply ? 'dark' : 'light');
                }

                if (darkModeSwitch) {
                    darkModeSwitch.checked = themeToApply;
                }

                const savedLang = localStorage.getItem('lang') || (prefs && prefs.language) || 'en';
                const langToApply = (savedLang === 'ar' || dataLanguage === 'ar') ? 'ar' : 'en';
                if (languageSelect) {
                    languageSelect.value = langToApply;
                }
                if (typeof window.setLanguage === 'function') {
                    window.setLanguage(langToApply);
                } else {
                    applyLanguage(langToApply);
                }
            }

            initializeSettings();
            setTimeout(initializeSettings, 100);

            const darkModeCard = document.getElementById('darkModeCard');
            if (darkModeCard && darkModeSwitch) {
                darkModeCard.addEventListener('click', function (e) {
                    if (e.target.closest('.sd-switch')) return;
                    darkModeSwitch.checked = !darkModeSwitch.checked;
                    darkModeSwitch.dispatchEvent(new Event('change', { bubbles: true }));
                });
            }

            if (darkModeSwitch) {
                darkModeSwitch.addEventListener('change', function (e) {
                    e.stopPropagation();
                    const isDarkMode = darkModeSwitch.checked;
                    if (typeof window.setTheme === 'function') {
                        window.setTheme(isDarkMode);
                    } else {
                        document.documentElement.setAttribute('data-theme', isDarkMode ? 'dark' : 'light');
                        document.documentElement.classList.toggle('light-mode-global', !isDarkMode);
                        document.body.classList.toggle('light-mode', !isDarkMode);
                        document.body.classList.toggle('dark-mode', isDarkMode);
                        localStorage.setItem('theme', isDarkMode ? 'dark' : 'light');
                        const langNow = languageSelect ? languageSelect.value : dataLanguage;
                        localStorage.setItem('medicalAiPrefs', JSON.stringify({ isDarkMode: isDarkMode, language: langNow }));
                    }
                    updateSettings({ isDarkMode: isDarkMode }).catch(function () { });
                });
            }

            function applyLanguage(lang) {
                if (typeof setLanguage === 'function') {
                    setLanguage(lang);
                } else {
                    const html = document.documentElement;
                    html.setAttribute('dir', lang === 'ar' ? 'rtl' : 'ltr');
                    html.setAttribute('lang', lang);
                    localStorage.setItem('medicalAiPrefs', JSON.stringify({
                        isDarkMode: darkModeSwitch ? darkModeSwitch.checked : dataIsDarkMode,
                        language: lang
                    }));
                }
            }

            window.selectLanguage = function (lang) {
                if (languageSelect) {
                    languageSelect.value = lang;
                }
                if (typeof window.setLanguage === 'function') {
                    window.setLanguage(lang);
                } else {
                    applyLanguage(lang);
                }
                updateSettings({ language: lang }).catch(function () { });
            };

            if (languageSelect) {
                languageSelect.addEventListener('change', function () {
                    window.selectLanguage(languageSelect.value);
                });
            }

            if (copyBtn && userIdEl) {
                copyBtn.addEventListener('click', async function () {
                    const text = userIdEl.textContent || '';
                    try {
                        await navigator.clipboard.writeText(text.trim());
                        copyBtn.classList.add('sd-copied');
                        const icon = copyBtn.querySelector('.bi');
                        if (icon) {
                            icon.classList.remove('bi-clipboard');
                            icon.classList.add('bi-check-lg');
                        }
                        setTimeout(function () {
                            copyBtn.classList.remove('sd-copied');
                            if (icon) {
                                icon.classList.add('bi-clipboard');
                                icon.classList.remove('bi-check-lg');
                            }
                        }, 1800);
                    } catch (_) { }
                });
            }

            document.getElementById('btnChangePassword')?.addEventListener('click', function () {
                /* Placeholder for future password flow */
            });
        });
    </script>
}
